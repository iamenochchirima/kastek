{
  "name": "@kasitek-labs/server-support",
  "version": "0.1.1",
  "type": "module",
  "repository": "https://github.com/Kasitek-Labs/kasitek-labs.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./analytics-producer": {
      "types": "./dist/analytics-producer.d.ts",
      "import": "./dist/analytics-producer.js"
    },
    "./analytics-reporting": {
      "types": "./dist/analytics-reporting.d.ts",
      "import": "./dist/analytics-reporting.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@kasitek-labs/contracts": "workspace:*",
    "pg": "8.16.3",
    "jose": "6.1.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
