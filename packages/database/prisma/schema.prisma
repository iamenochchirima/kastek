generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js Required Tables (Client App) ─────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?

  accounts      Account[]
  sessions      Session[]

  businessProfile   BusinessProfile?
  botConfigurations BotConfiguration[]
  conversations     OnboardingConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Admin Users (Separate from Client Users) ─────────────

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // superadmin | admin | viewer

  assignedLeads QuoteRequest[] @relation("AssignedLeads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── KasiAI Domain Tables ──────────────────────────────────

model BusinessProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName   String
  businessType   String
  industry       String?
  description    String?  @db.Text

  address    String?
  city       String?
  province   String?
  postalCode String?
  country    String @default("ZA")

  phone          String?
  whatsappNumber String?
  website        String?

  operatingHours      Json?
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BotConfiguration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  type   String
  status String @default("draft")

  greetingMessage String? @db.Text
  personality     String?
  language        String  @default("en")

  capabilities      Json?
  knowledgeBase     Json?
  integrationConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model OnboardingConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step          Int    @default(0)
  status        String @default("in_progress")
  messages      Json   @default("[]")
  extractedData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Quote / Lead Capture ────────────────────────────────────

model QuoteRequest {
  id            String   @id @default(cuid())
  businessName  String
  contactPerson String
  phone         String
  email         String
  businessType  String
  services      String[]
  description   String?  @db.Text

  // Lead management fields
  source        String   @default("website") // website | facebook | linkedin | cold_email | referral | whatsapp | walk_in
  status        String   @default("new")     // new | contacted | interested | quoted | won | lost
  quoteAmount   Float?
  followUpDate  DateTime?
  notes         Json     @default("[]")      // Array of {text, timestamp, adminUserId, adminUserName}

  assignedToId  String?
  assignedTo    AdminUser? @relation("AssignedLeads", fields: [assignedToId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

// ─── Outreach / Cold Email Campaigns ─────────────────────────

model OutreachCampaign {
  id         String   @id @default(cuid())
  name       String   // e.g. "Restaurants Feb 2026"
  category   String   // bizbay category slug
  status     String   @default("draft") // draft | active | paused | completed
  totalLeads Int      @default(0)
  emailsSent Int      @default(0)
  replies    Int      @default(0)

  leads OutreachLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutreachLead {
  id         String           @id @default(cuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  businessName String
  website      String?
  address      String?
  bizbayUrl    String?
  category     String

  phone         String?

  // Email outreach tracking
  emailStatus   String    @default("pending") // pending | sent | replied | interested | not_interested | bounced
  emailAddress  String?
  emailSentAt   DateTime?
  emailTemplate String?
  followUpCount Int       @default(0)
  lastFollowUp  DateTime?
  nextFollowUp  DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([emailStatus])
}

// ─── Web Services Leads (Cold Call) ──────────────────────────

model WebServiceLead {
  id           String   @id @default(cuid())
  businessName String
  website      String?
  address      String?
  category     String
  bizbayUrl    String?
  phone        String?
  email        String?

  callStatus   String   @default("pending") // pending | called | interested | not_interested | no_answer | callback
  notes        String?  @db.Text
  callbackDate DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([callStatus])
  @@index([category])
}

// ─── Chatbot Conversations ───────────────────────────────────

model Conversation {
  id                 String   @id @default(cuid())
  channel            String   // whatsapp | website
  customerIdentifier String   // phone number or session ID
  customerName       String?
  status             String   @default("active") // active | closed
  lastMessageAt      DateTime @default(now())

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, customerIdentifier])
  @@index([channel])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // customer | bot
  content        String       @db.Text
  timestamp      DateTime     @default(now())

  @@index([conversationId])
}
