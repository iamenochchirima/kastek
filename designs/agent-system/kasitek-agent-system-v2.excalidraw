      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "An old summarizer finishes\nafter a newer user correction.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-0-scenario",
      "originalText": "An old summarizer finishes\nafter a newer user correction.",
