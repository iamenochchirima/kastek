    },
    {
      "id": "XInnQZdgnmE8v072LROaF",
      "type": "text",
      "x": 9487.117248535156,
      "y": 278.75,
      "width": 445.7655029296875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#6741a5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2r",
      "roundness": null,
      "seed": 1508619914,
      "version": 3,
      "versionNonce": 243994698,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Immutable coverage + compare-and-swap.\nKeep current instructions and receipts\noutside the narrative summary.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-0-contract",
      "originalText": "Immutable coverage + compare-and-swap.\nKeep current instructions and receipts\noutside the narrative summary.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2sBJ0fnzVDHvPmHNsqcpM",
      "type": "text",
      "x": 10346.615295410156,
      "y": 278.75,
      "width": 416.7694091796875,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#26734d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2s",
      "roundness": null,
      "seed": 755520842,
      "version": 3,
      "versionNonce": 1067741526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Race summary completions both ways.\nCoverage never regresses; latest\nconstraints reach the next model call.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-0-evidence",
      "originalText": "Race summary completions both ways.\nCoverage never regresses; latest\nconstraints reach the next model call.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZZmpqRKo3WwzRWYQXqbQ-",
      "type": "text",
      "x": 8757.982391357422,
      "y": 537.5,
      "width": 364.03521728515625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#245b9d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2t",
      "roundness": null,
      "seed": 413342730,
      "version": 3,
      "versionNonce": 1343649546,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "A source or connection is revoked\nwhile a child/model call is running.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-1-scenario",
      "originalText": "A source or connection is revoked\nwhile a child/model call is running.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GV5tiXAk0vIkrzlEdt0rR",
      "type": "text",
      "x": 9502.132293701172,
      "y": 523.75,
      "width": 415.73541259765625,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#6741a5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2u",
      "roundness": null,
      "seed": 985074378,
      "version": 3,
      "versionNonce": 1006098070,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Recheck current generations at reuse,\ndispatch, return and disclosure.\nQuarantine invalid-derived output.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-1-contract",
      "originalText": "Recheck current generations at reuse,\ndispatch, return and disclosure.\nQuarantine invalid-derived output.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HKqI0jnP51j3s4nYdUxrS",
      "type": "text",
      "x": 10367.504333496094,
      "y": 523.75,
      "width": 374.9913330078125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#26734d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2v",
      "roundness": null,
      "seed": 970924426,
      "version": 3,
      "versionNonce": 17237450,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Revoke at each boundary. No new\nunauthorized use; already-started\neffects retain truthful receipts.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-1-evidence",
      "originalText": "Revoke at each boundary. No new\nunauthorized use; already-started\neffects retain truthful receipts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "palAR6AwhWpUJySX1cNPN",
      "type": "text",
      "x": 8759.005401611328,
      "y": 782.5,
      "width": 361.98919677734375,
      "height": 55,
      "angle": 0,
      "strokeColor": "#245b9d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2w",
      "roundness": null,
      "seed": 827744330,
      "version": 3,
      "versionNonce": 992777174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "A provider accepted the action,\nbut the worker lost its response.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-2-scenario",
      "originalText": "A provider accepted the action,\nbut the worker lost its response.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "LBxJujPN93-VWEQw_-Mdf",
      "type": "text",
      "x": 9496.324310302734,
      "y": 768.75,
      "width": 427.35137939453125,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#6741a5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2x",
      "roundness": null,
      "seed": 486000394,
      "version": 3,
      "versionNonce": 1249361034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Stable effect intent + exact payload.\nProvider idempotency or reconciliation.\nUnknown is not failed or safe to retry.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-2-contract",
      "originalText": "Stable effect intent + exact payload.\nProvider idempotency or reconciliation.\nUnknown is not failed or safe to retry.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-sW-tW40E_bip0UOwrRac",
      "type": "text",
      "x": 10358.671340942383,
      "y": 768.75,
      "width": 392.6573181152344,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#26734d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2y",
      "roundness": null,
      "seed": 1161713098,
      "version": 3,
      "versionNonce": 123185430,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Crash after remote acceptance.\nResume the same intent and receipt\nwithout a duplicate physical effect.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-2-evidence",
      "originalText": "Crash after remote acceptance.\nResume the same intent and receipt\nwithout a duplicate physical effect.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DwRb0HzxzOniG7pCtEUo8",
      "type": "text",
      "x": 8791.191482543945,
      "y": 1027.5,
      "width": 297.6170349121094,
      "height": 55,
      "angle": 0,
      "strokeColor": "#245b9d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2z",
      "roundness": null,
      "seed": 725945482,
      "version": 3,
      "versionNonce": 2049153866,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Two parallel agents change\nthe same business record.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-3-scenario",
      "originalText": "Two parallel agents change\nthe same business record.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FYVHaZnQq7-RMyZPImden",
      "type": "text",
      "x": 9507.841339111328,
      "y": 1013.75,
      "width": 404.31732177734375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#6741a5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b30",
      "roundness": null,
      "seed": 1959193418,
      "version": 3,
      "versionNonce": 1609438806,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Product resource preconditions and\nwork-scoped effect claims. Different\noperation IDs do not solve conflicts.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-3-contract",
      "originalText": "Product resource preconditions and\nwork-scoped effect claims. Different\noperation IDs do not solve conflicts.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "PvCqkE2rg4ZGUClWOl3uS",
      "type": "text",
      "x": 10375.391387939453,
      "y": 1013.75,
      "width": 359.21722412109375,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#26734d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b31",
      "roundness": null,
      "seed": 1478423050,
      "version": 3,
      "versionNonce": 1852154378,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Attempt stale concurrent writes.\nReject conflicts and require an\nexplicit revised action/review.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-3-evidence",
      "originalText": "Attempt stale concurrent writes.\nReject conflicts and require an\nexplicit revised action/review.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XRenjgKHuCSF3sOBDztRE",
      "type": "text",
      "x": 8755.518371582031,
      "y": 1272.5,
      "width": 368.9632568359375,
      "height": 55,
      "angle": 0,
      "strokeColor": "#245b9d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b32",
      "roundness": null,
      "seed": 138944714,
      "version": 3,
      "versionNonce": 1304746902,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "A child can read private data\nthat its parent must not receive.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-4-scenario",
      "originalText": "A child can read private data\nthat its parent must not receive.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "H6TBns_ojPlY0QmqZ12o4",
      "type": "text",
      "x": 9490.901260375977,
      "y": 1258.75,
      "width": 438.1974792480469,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#6741a5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b33",
      "roundness": null,
      "seed": 551384970,
      "version": 3,
      "versionNonce": 37277898,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Separate action and information scopes.\nRestrict child inputs to allowed output\naudiences; no LLM-only declassification.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-4-contract",
      "originalText": "Separate action and information scopes.\nRestrict child inputs to allowed output\naudiences; no LLM-only declassification.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lXzdP3YhL8e6DLH5MMysu",
      "type": "text",
      "x": 10375.182388305664,
      "y": 1258.75,
      "width": 359.6352233886719,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#26734d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b34",
      "roundness": null,
      "seed": 303691338,
      "version": 3,
      "versionNonce": 1997600982,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Use inaccessible child memory and\na different provider/audience.\nReject indirect disclosure.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-4-evidence",
      "originalText": "Use inaccessible child memory and\na different provider/audience.\nReject indirect disclosure.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cuFqipo82QdIiqbEmhtWF",
      "type": "text",
      "x": 8758.598388671875,
      "y": 1517.5,
      "width": 362.80322265625,
      "height": 55,
      "angle": 0,
      "strokeColor": "#245b9d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b35",
      "roundness": null,
      "seed": 215522570,
      "version": 3,
      "versionNonce": 2033723274,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793637133183,
      "link": null,
      "locked": false,
      "text": "Parents occupy all compute slots\nwhile waiting for their children.",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c-5-scenario",
      "originalText": "Parents occupy all compute slots\nwhile waiting for their children.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "3-Sra9hbnH5zCBlmB1MEb",
