      "text": "Deterministic isolation/recovery checks and model-quality evaluations are different evidence. Neither certifies the other.",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deterministic isolation/recovery checks and model-quality evaluations are different evidence. Neither certifies the other.",
      "autoResize": true,
      "lineHeight": 1.25
    },
