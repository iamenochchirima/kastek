# Local-only configuration. Generate secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
IDENTITY_DB_PASSWORD=replace-with-random-password
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-password
GROWTH_OIDC_CLIENT_SECRET=replace-with-random-secret
# Generate a separate confidential client secret for Agency partner login.
AGENCY_PARTNER_OIDC_CLIENT_SECRET=replace-with-independent-random-secret
AGENCY_PARTNER_SESSION_ADMIN_SECRET=replace-with-independent-random-secret
# Independent Agents browser and backend service secrets.
AGENTS_OIDC_CLIENT_SECRET=replace-with-independent-random-secret
AGENTS_EXECUTION_CLIENT_SECRET=replace-with-independent-random-secret
# Leave empty until Google development credentials are available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROWTH_SESSION_ADMIN_SECRET=replace-with-independent-random-secret
# Optional SMTP override for delivery to real inboxes. Leave blank to use local Mailpit.
# Resend example: smtp.resend.com:465, username resend, password a domain-restricted sending API key, SSL=true.
# Use a sender address on a domain verified in the Resend account.
IDENTITY_SMTP_HOST=
IDENTITY_SMTP_PORT=
IDENTITY_SMTP_FROM=
IDENTITY_SMTP_FROM_DISPLAY_NAME=
IDENTITY_SMTP_REPLY_TO=
IDENTITY_SMTP_USERNAME=
IDENTITY_SMTP_PASSWORD=
IDENTITY_SMTP_SSL=false
IDENTITY_SMTP_STARTTLS=false

# Separate platform administration browser login.
LABS_ADMIN_OIDC_CLIENT_SECRET=replace-with-independent-random-secret
