# Local-only configuration. Generate secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
IDENTITY_DB_PASSWORD=replace-with-random-password
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-random-password
GROWTH_OIDC_CLIENT_SECRET=replace-with-random-secret
# Leave empty until Google development credentials are available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GROWTH_SESSION_ADMIN_SECRET=replace-with-independent-random-secret
