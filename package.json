{
  "name": "kasiai-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter client dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm db:generate && pnpm --filter './apps/*' build",
    "build:client": "pnpm db:generate && pnpm --filter client build",
    "build:admin": "pnpm db:generate && pnpm --filter admin build",
    "db:generate": "pnpm --filter @kasiai/database generate",
    "db:push": "pnpm --filter @kasiai/database db:push",
    "db:migrate": "pnpm --filter @kasiai/database db:migrate",
    "db:studio": "pnpm --filter @kasiai/database studio",
    "db:seed": "pnpm --filter @kasiai/database seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ]
  }
}
