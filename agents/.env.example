NODE_ENV=development
PORT=4100
HOST=0.0.0.0
AGENTS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kasitek_agents
AGENTS_DATABASE_POOL_MAX=10
TEMPORAL_ENABLED=true
TEMPORAL_MODE=cloud
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace
TEMPORAL_TASK_QUEUE=kasitek-agents-interactive
TEMPORAL_API_KEY=replace-with-a-dedicated-development-api-key
# Opt-in durable loop continuations; enable only after the recovery matrix passes.
TEMPORAL_STEP_ACTIVITIES_ENABLED=false
TEMPORAL_DECOMPOSED_ACTIVITIES_ENABLED=false
MCP_STATELESS_ENABLED=true
KASIAI_MODEL_PROVIDER=openrouter
KASIAI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
INTERNAL_AUTH_AUDIENCE=kasitek-agents
AUTH_MODE=headers
# In production this service uses AUTH_MODE=hmac. Set this to the same value as
# kasitek-core's AGENTS_INTERNAL_AUTH_SECRET.
INTERNAL_AUTH_SECRET=
KASITEK_CORE_URL=http://127.0.0.1:4000
KASITEK_APP_URL=http://localhost:3000
# Must match kasitek-core's KASITEK_AGENTS_INTERNAL_TOKEN for local development.
KASITEK_CORE_INTERNAL_TOKEN=replace-with-a-dedicated-core-agent-token
KASITEK_CORE_TIMEOUT_MS=10000
# Provider-backed publishing can include bounded media processing time.
KASITEK_CORE_PUBLISH_TIMEOUT_MS=30000
# Public kasitek-core origin that Telegram can reach. The webhook path is added by the platform.
TELEGRAM_WEBHOOK_BASE_URL=https://api.example.com
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_TIMEOUT_MS=10000
DISCORD_API_BASE_URL=https://discord.com/api/v10
DISCORD_API_TIMEOUT_MS=10000
# Optional server-side audio transcription. Leave empty to keep audio disabled.
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v2
ELEVENLABS_TRANSCRIPTION_TIMEOUT_MS=120000
# Run `pnpm dev:discord` / `start:discord` to connect active Discord channel records.
DISCORD_GATEWAY_ENABLED=false
DISCORD_GATEWAY_POLL_INTERVAL_MS=60000
DISCORD_GATEWAY_PLATFORM_URL=http://127.0.0.1:4100
# Optional managed website crawler. Keep this server-side; never expose it to the client.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_MS=60000
# Optional web search provider. Installation-scoped keys can be saved from an agent's Integrations tab.
TAVILY_API_KEY=
# Google Calendar OAuth. Set the redirect URI to the public Agent API callback URL.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
AGENT_INTEGRATIONS_RETURN_URL=
LOG_LEVEL=info
MODEL_PRICING_JSON='{"openrouter:*":{"inputUsdPerMillion":0,"outputUsdPerMillion":0}}'
AGENTS_CREDENTIAL_ENCRYPTION_KEY=
INSTALLATION_TOKEN_PRIVATE_KEY=
INSTALLATION_TOKEN_ISSUER=kasitek-agents
# Optional key identifier for rotating the per-invocation core delegation key.
# It must match an entry in core's AGENTS_DELEGATION_PUBLIC_KEYS_JSON map.
KASITEK_CORE_DELEGATION_KEY_ID=
# Required for `pnpm test:e2e:local`: generate a dedicated development ES256 key
# and set this value to its PEM contents. Do not reuse a production signing key.
AGENT_GATEWAY_SHARED_SECRET=
# Gateway-only transport controls. The Agent API remains the policy owner.
MCP_GATEWAY_ENABLED=true
MCP_GATEWAY_STATELESS_ENABLED=true
MCP_GATEWAY_RATE_LIMIT_PER_WINDOW=120
MCP_GATEWAY_PREAUTH_RATE_LIMIT_PER_WINDOW=60
MCP_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
MCP_GATEWAY_RATE_LIMIT_MAX_KEYS=10000
APPROVAL_DECISION_RATE_LIMIT_PER_WINDOW=5
APPROVAL_DECISION_RATE_LIMIT_WINDOW_MS=60000
APPROVAL_DECISION_RATE_LIMIT_MAX_KEYS=10000
EFFECT_RECONCILIATION_INTERVAL_MS=60000
RUN_BUDGET_RECONCILIATION_AGE_MS=300000
RUN_BUDGET_RECONCILIATION_LIMIT=100
MCP_GATEWAY_UPSTREAM_TIMEOUT_MS=15000
ANALYTICS_INGESTION_URL=http://127.0.0.1:4300
# Optional semantic retrieval. The released vector index uses 1536 dimensions.
EMBEDDINGS_ENABLED=false
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=10000
# Readiness evaluation is bounded and coordinated through the Agent PostgreSQL database.
AGENT_READINESS_EVALUATION_INTERVAL_MS=300000
AGENT_READINESS_EVALUATION_BATCH_SIZE=50
AGENT_READINESS_EVALUATION_LEASE_MS=900000
# Must match the agent-platform credential in server/kasitek-analytics/.env.
ANALYTICS_AGENT_INGESTION_TOKEN=
ANALYTICS_AGENT_PRODUCER_ID=agent-platform-customer-analytics
ANALYTICS_AGENT_PUBLISHER_ID=agent-platform-analytics-publisher
ANALYTICS_PUBLISHER_BATCH_SIZE=100
ANALYTICS_PUBLISHER_LEASE_DURATION_MS=30000
ANALYTICS_PUBLISHER_REQUEST_TIMEOUT_MS=10000
ANALYTICS_PUBLISHER_POLL_INTERVAL_MS=1000
ANALYTICS_PUBLISHER_RETRY_BASE_DELAY_MS=2000
ANALYTICS_PUBLISHER_RETRY_MAX_DELAY_MS=300000
ANALYTICS_PUBLISHER_RETRY_JITTER_MS=2000
# Comma-separated browser Origins allowed to reach the hosted MCP gateway. Leave empty for
# non-browser clients only; any presented Origin is rejected unless explicitly listed.
MCP_GATEWAY_ALLOWED_ORIGINS=
# The stdio bridge probes server/discover once before old-client traffic and falls back
# deterministically when the endpoint remains pre-2026 compatible.
MCP_STDIO_PROBE=true
