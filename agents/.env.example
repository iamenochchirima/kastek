NODE_ENV=development
PORT=4100
HOST=0.0.0.0
AGENTS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kasitek_agents
AGENTS_DATABASE_POOL_MAX=10
TEMPORAL_ENABLED=true
TEMPORAL_MODE=cloud
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace
TEMPORAL_TASK_QUEUE=kasitek-agents-interactive
TEMPORAL_API_KEY=replace-with-a-dedicated-development-api-key
KASIAI_MODEL_PROVIDER=openrouter
KASIAI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
INTERNAL_AUTH_AUDIENCE=kasitek-agents
AUTH_MODE=headers
# In production this service uses AUTH_MODE=hmac. Set this to the same value as
# kasitek-core's AGENTS_INTERNAL_AUTH_SECRET.
INTERNAL_AUTH_SECRET=
KASITEK_CORE_INTERNAL_TOKEN=replace-with-a-dedicated-core-agent-token
KASITEK_CORE_TIMEOUT_MS=10000
LOG_LEVEL=info
MODEL_PRICING_JSON='{"openrouter:*":{"inputUsdPerMillion":0,"outputUsdPerMillion":0}}'
AGENTS_CREDENTIAL_ENCRYPTION_KEY=
INSTALLATION_TOKEN_PRIVATE_KEY=
INSTALLATION_TOKEN_ISSUER=kasitek-agents
