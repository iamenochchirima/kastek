{
  "name": "@kasitek/agents",
  "version": "0.1.0",
  "private": true,
  "description": "KasiTek Agent Platform API and durable worker",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0 <24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/http/server.ts",
    "dev:gateway": "tsx watch src/gateway/server.ts",
    "dev:stdio": "tsx src/gateway/stdio.ts",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "start:api": "node dist/http/server.js",
    "start:gateway": "node dist/gateway/server.js",
    "start:stdio": "node dist/gateway/stdio.js",
    "start:worker": "node dist/temporal/worker.js",
    "test:e2e:local": "tsx scripts/local-e2e-smoke.ts",
    "generate:capabilities": "tsx scripts/generate-capability-docs.ts",
    "migrate": "tsx src/db/migrate.ts",
    "bootstrap:kasiai": "tsx src/system/bootstrap-kasiai.ts",
    "release:kasiai": "tsx src/system/release-kasiai.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "@temporalio/activity": "^1.13.0",
    "@temporalio/client": "^1.13.0",
    "@temporalio/worker": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
