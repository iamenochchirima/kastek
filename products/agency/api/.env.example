# Native Node 24 service. Use a dedicated Agency PostgreSQL database.
TENANT_DATABASE_URL=postgresql://agency:change-me@127.0.0.1:5432/kasitek_agency
TENANT_SERVER_PORT=8090
TENANT_SERVER_ENVIRONMENT=development
TENANT_DATABASE_MAX_CONNECTIONS=10
TENANT_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3001
TENANT_CORS_ALLOW_CREDENTIALS=true
TENANT_APP_BASE_URL=http://localhost:3010
# Configure a workspace slug or platform/custom host before portal sign-in.
TENANT_DEFAULT_WORKSPACE_SLUG=
TENANT_PLATFORM_BASE_DOMAIN=
TENANT_PORTAL_HOST_TARGET=
TENANT_SESSION_COOKIE_NAME=kasitenant.session
TENANT_CLIENT_SESSION_COOKIE_NAME=kasitenant.client.session
TENANT_SESSION_COOKIE_SECURE=false
TENANT_SESSION_COOKIE_SAME_SITE=lax
TENANT_SESSION_TTL_HOURS=336
TENANT_CLIENT_SESSION_TTL_HOURS=336
# KasiTek Agency partners authenticate through the Labs Keycloak realm.
TENANT_PARTNER_SESSION_COOKIE_NAME=kasitek.agency.partner
TENANT_PARTNER_SESSION_IDLE_DAYS=7
TENANT_PARTNER_SESSION_ABSOLUTE_DAYS=30
TENANT_PARTNER_MAX_BUSINESSES=10
TENANT_PARTNER_OIDC_ISSUER_URL=http://localhost:8080/realms/kasitek
TENANT_PARTNER_OIDC_CLIENT_ID=agency-partner
TENANT_PARTNER_OIDC_CLIENT_SECRET=
TENANT_PARTNER_OIDC_ADMIN_CLIENT_ID=agency-partner-session-admin
TENANT_PARTNER_OIDC_ADMIN_CLIENT_SECRET=
TENANT_PARTNER_OIDC_REDIRECT_URI=http://localhost:3010/api/tenant/api/partner/auth/callback
TENANT_PARTNER_APP_BASE_URL=http://localhost:3010
TENANT_INVITE_TTL_HOURS=168
# Set a private admin secret before exposing provisioning endpoints.
TENANT_ADMIN_SECRET=
# Optional Resend and Analytics configuration. Never place private keys in browser variables.
TENANT_RESEND_API_KEY=
TENANT_RESEND_FROM_EMAIL=
TENANT_SHARED_EMAIL_DOMAIN=send.kasitek.co.za
ANALYTICS_INGESTION_URL=http://127.0.0.1:4300
ANALYTICS_TENANT_INGESTION_TOKEN=
ANALYTICS_REPORTING_URL=http://127.0.0.1:4300
ANALYTICS_REPORTING_PRIVATE_KEY=
ANALYTICS_REPORTING_KEY_ID=
ANALYTICS_REPORTING_RESOLVER_TOKEN=
ANALYTICS_REPORTING_ISSUER=kasitek-tenant-platform
ANALYTICS_REPORTING_AUDIENCE=kasitek-analytics-reporting
# API is the default. Separate processes: analytics-publisher, analytics-backfill-worker.
KASITEK_PROCESS=api

# Request-bound Labs admin reporting authority, independent from portal/admin keys.
KASITEK_ADMIN_SERVICE_SECRET=

# Development-only Labs customer metadata; actions stay off until individually enabled.
KASITEK_CUSTOMER_OPERATIONS=0
KASITEK_CUSTOMER_ACTIONS=
