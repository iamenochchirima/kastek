// ─── Quote / Lead Capture ────────────────────────────────────

model QuoteRequest {
  id            String   @id @default(cuid())
  businessName  String
  contactPerson String
  phone         String
  email         String
  businessType  String
  services      String[]
  description   String?  @db.Text

  // Lead management fields
  source       String    @default("website") // website | facebook | linkedin | cold_email | referral | whatsapp | walk_in
  status       String    @default("new") // new | contacted | interested | quoted | won | lost
  quoteAmount  Float?
  followUpDate DateTime?
  notes        Json      @default("[]") // Array of {text, timestamp, adminUserId, adminUserName}

  assignedToId String?
  assignedTo   AdminUser?  @relation("AssignedLeads", fields: [assignedToId], references: [id])
  quotations   Quotation[]
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

model ProductWaitlistEntry {
  id                   String                @id @default(cuid())
  businessName         String?
  contactPerson        String
  phone                String?
  email                String
  businessType         String?
  website              String?
  products             String[]
  notes                String?               @db.Text
  source               String                @default("website")
  status               String                @default("new")
  cohort               String                @default("beta")
  contactConsentAt     DateTime?
  reviewNotes          String?               @db.Text
  decisionReason       String?               @db.Text
  reviewedById         String?
  reviewedAt           DateTime?
  approvedById         String?
  approvedAt           DateTime?
  organizationId       String?
  earlyAccessInvitationId String? @unique
  packageKey           String?
  packageSnapshot      Json?
  activatedAt          DateTime?
  earlyAccessEndsAt    DateTime?
  entitlementGrantIds  Json                  @default("[]")
  creditGrantId        String?

  events ProductWaitlistEvent[]
  earlyAccessInvitation EarlyAccessInvitation? @relation("CurrentEarlyAccessInvitation", fields: [earlyAccessInvitationId], references: [id], onDelete: SetNull)
  earlyAccessInvitations EarlyAccessInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([cohort, status, createdAt])
  @@index([email])
  @@index([organizationId])
  @@index([earlyAccessEndsAt])
  @@index([source])
}

model EarlyAccessInvitation {
  id                    String   @id @default(cuid())
  waitlistEntryId       String
  waitlistEntry         ProductWaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  currentFor            ProductWaitlistEntry? @relation("CurrentEarlyAccessInvitation")
  email                 String
  tokenHash             String   @unique
  status                String   @default("pending")
  deliveryStatus        String   @default("pending")
  deliveryAttempts      Int      @default(0)
  lastDeliveryAttemptAt DateTime?
  lastDeliveryErrorCode String?
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([waitlistEntryId, status])
  @@index([status, expiresAt])
}

model ProductWaitlistEvent {
  id              String               @id @default(cuid())
  waitlistEntryId String
  fromStatus      String?
  toStatus        String
  action          String
  actorId         String?
  reason          String?              @db.Text
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())

  waitlistEntry ProductWaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)

  @@index([waitlistEntryId, createdAt])
  @@index([action, createdAt])
}

model Quotation {
  id                    String   @id @default(cuid())
  businessName          String
  contactPerson         String
  contactEmail          String
  contactPhone          String
  date                  DateTime
  serviceType           String   @default("website_agent")
  title                 String
  introduction          String?  @db.Text
  scopeOfWork           Json     @default("[]")
  deliverables          Json     @default("[]")
  implementationSteps   Json     @default("[]")
  pricingItems          Json     @default("[]")
  maintenanceIncludes   Json     @default("[]")
  termsAndNotes         Json     @default("[]")
  includedFunctionality Json     @default("[]")
  knowledgeBaseScope    Json     @default("[]")
  importantNotes        Json     @default("[]")
  supportIncludes       Json     @default("[]")
  setupFee              String
  monthlyFee            String
  deliveryTimeline      String?
  validityDays          Int      @default(14)
  status                String   @default("draft") // draft | sent | accepted | rejected | expired

  quoteRequestId String?
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([quoteRequestId])
}

model Invoice {
  id                    String    @id @default(cuid())
  businessName          String
  contactPerson         String
  contactEmail          String
  contactPhone          String
  date                  DateTime
  serviceType           String    @default("website_agent")
  billingMode           String    @default("one_off")
  recurringActive       Boolean   @default(false)
  billingAnchorDay      Int?
  reminderDaysAfterDue  Int       @default(3)
  lastSentAt            DateTime?
  lastReminderAt        DateTime?
  lastPaidAt            DateTime?
  title                 String
  introduction          String?   @db.Text
  scopeOfWork           Json      @default("[]")
  deliverables          Json      @default("[]")
  implementationSteps   Json      @default("[]")
  pricingItems          Json      @default("[]")
  maintenanceIncludes   Json      @default("[]")
  termsAndNotes         Json      @default("[]")
  includedFunctionality Json      @default("[]")
  knowledgeBaseScope    Json      @default("[]")
  importantNotes        Json      @default("[]")
  supportIncludes       Json      @default("[]")
  setupFee              String
  monthlyFee            String
  deliveryTimeline      String?
  validityDays          Int       @default(14)
  status                String    @default("draft") // draft | sent | paid | overdue | cancelled

  quoteRequestId String?
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  runs           InvoiceRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([quoteRequestId])
  @@index([billingMode, recurringActive])
}

model InvoiceRun {
  id                   String    @id @default(cuid())
  invoiceId            String
  invoice              Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cycleKey             String
  issueDate            DateTime
  periodStart          DateTime
  periodEnd            DateTime
  dueDate              DateTime
  status               String    @default("pending") // pending | sent | reminder_due | reminder_sent | paid | overdue | cancelled
  sendStatus           String    @default("pending") // pending | sent
  reminderStatus       String    @default("not_needed") // not_needed | pending | sent
  sentAt               DateTime?
  reminderDueAt        DateTime?
  reminderSentAt       DateTime?
  paidAt               DateTime?
  pricingItemsSnapshot Json      @default("[]")
  titleSnapshot        String
  contactEmailSnapshot String
  businessNameSnapshot String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([invoiceId, cycleKey])
  @@index([invoiceId, issueDate])
  @@index([status, dueDate])
  @@index([sendStatus, issueDate])
  @@index([reminderStatus, reminderDueAt])
}

// ─── Outreach / Cold Email Campaigns ─────────────────────────

model OutreachCampaign {
  id         String @id @default(cuid())
  name       String // e.g. "Restaurants Feb 2026"
  category   String // bizbay category slug
  status     String @default("draft") // draft | active | paused | completed
  totalLeads Int    @default(0)
  emailsSent Int    @default(0)
  replies    Int    @default(0)

  leads        OutreachLead[]
  deliveryLogs OutreachEmailDeliveryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutreachLead {
  id         String           @id @default(cuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  businessName String
  website      String?
  address      String?
  bizbayUrl    String?
  category     String

  phone String?

  // Email outreach tracking
  emailStatus   String    @default("pending") // pending | sent | replied | interested | not_interested | bounced
  emailAddress  String?
  emailSentAt   DateTime?
  emailTemplate String?
  followUpCount Int       @default(0)
  lastFollowUp  DateTime?
  nextFollowUp  DateTime?

  notes        String?                    @db.Text
  deliveryLogs OutreachEmailDeliveryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([emailStatus])
}

model OutreachEmailDeliveryLog {
  id         String            @id @default(cuid())
  campaignId String?
  campaign   OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       OutreachLead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  isTest     Boolean           @default(false)

  recipient         String
  subject           String
  status            String // sent | failed
  provider          String   @default("smtp")
  providerMessageId String?
  providerResponse  String?  @db.Text
  errorMessage      String?  @db.Text
  attemptedAt       DateTime @default(now())

  @@index([campaignId, attemptedAt])
  @@index([leadId, attemptedAt])
  @@index([status])
  @@index([isTest, attemptedAt])
}

// ─── Web Services Leads (Cold Call) ──────────────────────────

model WebServiceLead {
  id           String  @id @default(cuid())
  businessName String
  website      String?
  address      String?
  category     String
  bizbayUrl    String?
  phone        String?
  email        String?

  callStatus   String    @default("pending") // pending | called | interested | not_interested | no_answer | callback
  notes        String?   @db.Text
  callbackDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([callStatus])
  @@index([category])
}

// ─── Chatbot Conversations ───────────────────────────────────

model Customer {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  displayName String?
  metadata    Json?

  identities       CustomerIdentity[]
  conversations    Conversation[]
  whatsappContacts WhatsappContact[]
  bookings         Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, id])
  @@index([orgId, displayName])
  @@index([orgId, updatedAt])
}

model CustomerIdentity {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer     @relation(fields: [orgId, customerId], references: [orgId, id], onDelete: Cascade)

  channel     String
  scopeId     String?
  externalId  String
  identityKey String
  displayName String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, identityKey])
  @@index([customerId, channel])
  @@index([orgId, channel, externalId])
}

// ─── Bookings ──────────────────────────────────────────────

enum BookingStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model BookingService {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  description     String?      @db.Text
  durationMinutes Int
  active          Boolean      @default(true)
  bookings        Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name])
  @@index([orgId, active])
}

model Booking {
  id             String         @id @default(cuid())
  orgId          String
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serviceId      String
  service        BookingService @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customerId     String?
  customer       Customer?      @relation(fields: [orgId, customerId], references: [orgId, id], onDelete: Restrict)
  contactName    String
  contactPhone   String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  timezone       String         @default("Africa/Johannesburg")
  status         BookingStatus  @default(SCHEDULED)
  notes          String?        @db.Text
  createdById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, scheduledStart])
  @@index([orgId, status, scheduledStart])
  @@index([serviceId, scheduledStart])
  @@index([customerId, scheduledStart])
}

model Conversation {
  id                 String    @id @default(cuid())
  channel            String // whatsapp | website
  customerIdentifier String // phone number or session ID
  customerName       String?
  status             String    @default("active") // active | closed
  lastMessageAt      DateTime  @default(now())
  lastReadAt         DateTime?
  unreadCount        Int       @default(0)
  starred            Boolean   @default(false)

  orgId                String?
  org                  Organization?       @relation(fields: [orgId], references: [id], onDelete: SetNull)
  externalConnectionId String?
  externalConnection   ExternalConnection? @relation(fields: [externalConnectionId], references: [id], onDelete: SetNull)
  customerId           String?
  customer             Customer?           @relation(fields: [orgId, customerId], references: [orgId, id], onDelete: Restrict)

  messages      Message[]
  messageEvents MessageEvent[]
  callSessions  WhatsappCallSession[]
  calls         CommunicationCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, customerIdentifier])
  @@index([channel])
  @@index([orgId, lastMessageAt])
  @@index([externalConnectionId, lastMessageAt])
  @@index([customerId, lastMessageAt])
  @@index([lastMessageAt])
}

model CommunicationCall {
  id                String               @id @default(cuid())
  orgId             String
  org               Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider          String
  providerCallId    String?
  connectionId      String?
  connection        ExternalConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  conversationId    String?
  conversation      Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  whatsappSessionId String?              @unique
  whatsappSession   WhatsappCallSession? @relation(fields: [whatsappSessionId], references: [id], onDelete: SetNull)
  direction         String
  status            String
  fromPhone         String
  toPhone           String
  agentLabel        String?
  startedAt         DateTime?
  answeredAt        DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  errorCode         String?
  errorMessage      String?              @db.Text
  rawPayload        Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  legs CommunicationCallLeg[]

  @@unique([provider, providerCallId])
  @@index([orgId, createdAt])
  @@index([orgId, status, createdAt])
  @@index([connectionId, createdAt])
  @@index([conversationId, createdAt])
}

model CommunicationCallLeg {
  id              String            @id @default(cuid())
  callId          String
  call            CommunicationCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  providerLegId   String?
  direction       String
  status          String
  fromPhone       String?
  toPhone         String?
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  errorCode       String?
  errorMessage    String?           @db.Text
  rawPayload      Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([callId, providerLegId])
  @@index([callId, createdAt])
}

model Message {
  id                          String       @id @default(cuid())
  conversationId              String
  conversation                Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                      String // customer | bot
  content                     String       @db.Text
  contentType                 String       @default("TEXT")
  providerMessageId           String?
  providerStatus              String?
  providerMetadata            Json?
  whatsappMessageId           String?
  whatsappStatus              String?
