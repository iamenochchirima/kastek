  sendEvents WhatsappSendEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([orgId, status])
  @@index([userId, listLabel])
  @@index([connectionId])
  @@index([templateId])
  @@index([scheduledAt])
}

model WhatsappCampaignRecipient {
  id         String           @id @default(cuid())
  campaignId String
  campaign   WhatsappCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId         String
  contact           WhatsappContact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  snapshotPhone     String?
  snapshotFullName  String?
  snapshotLocation  String?
  snapshotListLabel String?
  snapshotMetadata  Json?

  status      WhatsappRecipientStatus @default(PENDING)
  waMessageId String?

  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  attemptCount Int              @default(0)
  lastAttemptAt DateTime?
  errorCode    String?
  errorMessage String?   @db.Text

  sendEvents WhatsappSendEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([waMessageId])
}

model WhatsappSendEvent {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  connectionId String
  connection   WhatsappConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  campaignId String?
  campaign   WhatsappCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  recipientId String?
  recipient   WhatsappCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  contactId String?
  contact   WhatsappContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  phone                       String
  templateName                String
  status                      WhatsappRecipientStatus
  whatsappMessageId           String?
  whatsappConversationId      String?
  whatsappConversationOrigin  String?
  whatsappConversationExpires DateTime?
  whatsappPricingBillable     Boolean?
  whatsappPricingCategory     String?
  whatsappPricingModel        String?
  whatsappPricingType         String?

  requestPayload  Json?
  responsePayload Json?
  errorCode       String?
  errorMessage    String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([campaignId])
  @@index([recipientId])
  @@index([contactId])
  @@index([status])
}

model GrowthAgentReview {
  id                   String @id
  orgId                String
  actorId              String
  taskId               String
  conversationId       String
  featureId            String
  operationId          String
  requestDigest        String
  payloadDigest        String
  draft                Json
  context              Json?
  contextRevision      String?
  destinationRevisions Json
  rootReviewId         String
  supersededBy         String?
  state                String @default("proposed")
  result               Json?
  decisionRequestId    String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  expiresAt            DateTime @db.Timestamptz(3)
  org                  Organization @relation("GrowthAgentReviewOrganization", fields: [orgId], references: [id], onDelete: Cascade)
  actor                User @relation("GrowthAgentReviewActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([orgId, actorId, operationId])
  @@index([orgId, actorId, taskId, createdAt])
  @@index([rootReviewId])
}

model AdminSession {
  tokenHash String @id
  adminId String
  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([adminId])
  @@index([expiresAt])
}

model AdminCommercialAudit {
  id String @id
  actorId String
  action String
  resourceId String
  details Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz
}
model AdminOutreachSendAttempt {
  id String @id
  campaignId String
  leadId String
  fingerprint String @unique
  actorId String
  recipients Json
  subject String
  status String
  accepted Json @default("[]")
  rejected Json @default("[]")
  providerMessageId String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @db.Timestamptz
  @@index([leadId, createdAt], map: "AdminOutreachSendAttempt_lead")
}

/// Durable product setup intent. Provider credentials remain exclusively in Agents.
model GrowthAgentSetup {
  orgId String @id
  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestId String @unique
  defaultsRevision String @default("1")
  modelProfileId String
  modelProfileRevision String
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseOwner String?
  leaseExpiresAt DateTime?
  generation Int @default(0)
  failureCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model GrowthAgentSourceHandle {
  id String @id
  orgId String
  actorId String
  actorIssuer String
  context Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  org Organization @relation("GrowthAgentSourceOrganization",fields:[orgId],references:[id],onDelete:Cascade)
  actor User @relation("GrowthAgentSourceActor",fields:[actorId],references:[id],onDelete:Cascade)
  @@index([orgId,actorId])
}

model GrowthOAuthClient {
  id String @id
  name String
  redirectUris String[]
  registrationIpHash String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  requests GrowthOAuthRequest[]
  codes GrowthOAuthCode[]
  connections GrowthOAuthConnection[]
  @@index([registrationIpHash, createdAt])
}

model GrowthOAuthRequest {
  hash String @id
  clientId String
  client GrowthOAuthClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  redirectUri String
  resource String
  scopes String[]
  state String
  challenge String
  userId String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  usedAt DateTime? @db.Timestamptz(6)
  @@index([expiresAt])
}

model GrowthOAuthCode {
  hash String @id
  clientId String
  client GrowthOAuthClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userId String
  orgId String
  redirectUri String
  resource String
  scopes String[]
  challenge String
  expiresAt DateTime @db.Timestamptz(6)
  usedAt DateTime? @db.Timestamptz(6)
}

model GrowthOAuthConnection {
  id String @id
  clientId String
  client GrowthOAuthClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  userId String
  orgId String
  resource String
  scopes String[]
  accessHash String @unique
  accessExpiresAt DateTime @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  lastUsedAt DateTime? @db.Timestamptz(6)
  refreshTokens GrowthOAuthRefresh[]
  @@index([userId, orgId])
}

model GrowthOAuthRefresh {
  hash String @id
  connectionId String
  connection GrowthOAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(6)
  usedAt DateTime? @db.Timestamptz(6)
  @@index([connectionId])
}
