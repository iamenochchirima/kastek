  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String
  businessType String
  industry     String?
  description  String? @db.Text

  address    String?
  city       String?
  province   String?
  postalCode String?
  country    String  @default("ZA")

  phone          String?
  whatsappNumber String?
  website        String?

  operatingHours      Json?
