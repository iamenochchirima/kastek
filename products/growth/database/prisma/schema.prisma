  whatsappPricingModel        String?
  whatsappPricingType         String?
  errorCode                   String?
  errorMessage                String?      @db.Text
  editedAt                    DateTime?
  deletedAt                   DateTime?
  timestamp                   DateTime     @default(now())

  attachments  MessageAttachment[]
  reference    MessageReference?   @relation("MessageReplyReference")
  referencedBy MessageReference[]  @relation("ReferencedMessage")
