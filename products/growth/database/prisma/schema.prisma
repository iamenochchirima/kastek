  @@unique([conversationId, providerMessageId])
  @@index([conversationId])
  @@index([providerMessageId])
  @@index([providerStatus])
  @@index([whatsappMessageId])
  @@index([whatsappStatus])
  @@index([contentType])
  @@index([deletedAt])
