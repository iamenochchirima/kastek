  @@index([status, updatedAt])
  @@index([customerId, id], map: "AdminWebhookReplayCommand_customer_history_idx")
  @@index([deliveryId, createdAt])
}

model AdminCustomerReplayApproval {
  id String @id
  commandId String
  command AdminWebhookReplayCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)
  actorId String
  digest String
  reason String
  createdAt DateTime @default(now())
  @@unique([commandId, actorId])
}

model AdminWebhookReplayAuditEvent {
  id        String   @id @default(cuid())
  commandId String
  actorId   String
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  command AdminWebhookReplayCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@index([commandId, createdAt])
}

// ─── KasiTek Domain Tables ──────────────────────────────────

model BusinessProfile {
