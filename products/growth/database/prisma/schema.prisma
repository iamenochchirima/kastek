generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Organizations ─────────────────────────────────────────

model Organization {
  agentSetup GrowthAgentSetup?
  growthAgentReviews GrowthAgentReview[] @relation("GrowthAgentReviewOrganization")
  growthAgentSourceHandles GrowthAgentSourceHandle[] @relation("GrowthAgentSourceOrganization")
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  logo    String?
  ownerId String
  reportingTimezone String @default("UTC")

  owner       User                     @relation("OwnedOrganizations", fields: [ownerId], references: [id], onDelete: Restrict)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  socialChannelConnections       SocialChannelConnection[]
  emailConnections               EmailConnection[]
  emailInboxBindings             EmailInboxBinding[]
  emailOAuthStates               EmailOAuthState[]
  socialPosts                    SocialPost[]
  socialPublishJobs              SocialPublishJob[]
  socialPublishBatches           SocialPublishBatch[]
  socialPostInsightObservations  SocialPostInsightObservation[]
  socialPostInsightSyncStates    SocialPostInsightSyncState[]
  contentMediaAssets             ContentMediaAsset[]
  whatsappConnections            WhatsappConnection[]
  whatsappContacts               WhatsappContact[]
  whatsappContactListMemberships WhatsappContactListMembership[]
  whatsappTemplates              WhatsappTemplate[]
  whatsappCampaigns              WhatsappCampaign[]
  whatsappSendEvents             WhatsappSendEvent[]
  whatsappCallSessions           WhatsappCallSession[]
  calls                          CommunicationCall[]
  externalConnections            ExternalConnection[]
  customers                      Customer[]
  customerIdentities             CustomerIdentity[]
  conversations                  Conversation[]
  subscriptions                  OrganizationSubscription[]
  entitlementGrants              OrganizationEntitlementGrant[]
  usageEvents                    UsageEvent[]
  publicApiRequests              PublicApiRequest[]
  developerApiKeys               DeveloperApiKey[] @relation("DeveloperApiKeysOrganization")
  publicApiWebhookSubscriptions  PublicApiWebhookSubscription[]
  billingCheckouts               BillingCheckout[]
  billingInvoices                BillingInvoice[]
  billingIssues                  BillingReconciliationIssue[]
  creditAccount                  CreditAccount?
  creditGrants                   CreditGrant[]
  creditLedgerEntries            CreditLedgerEntry[]
  creditReservations             CreditReservation[]
  creditUsageEvents              CreditUsageEvent[]
  creditAdminOperations          CreditAdminOperation[]
  referralCodes                  ReferralCode[]          @relation("ReferralCodeOwner")
  referralsSent                  ReferralAttribution[]   @relation("ReferralReferrer")
  referralReceived               ReferralAttribution?   @relation("ReferralReferee")
  customerReplayCommands         AdminWebhookReplayCommand[]
  supportAccessGrants            AdminSupportAccessGrant[]
  bookingServices                BookingService[]
  bookings                       Booking[]
  onboardingProfile              OrganizationOnboardingProfile?
  productTours                   UserProductTour[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model OrganizationMember {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(MEMBER)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
}

model OrganizationOnboardingProfile {
  id             String       @id @default(cuid())
  orgId          String       @unique
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  website        String?
  primaryGoal    String?
  primaryGoals   String[]     @default([])
  teamRole       String?
  industry       String?
  referralSource String?
  completedAt    DateTime?
  skippedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrganizationInvitation {
  id          String    @id @default(cuid())
  orgId       String
  email       String
  role        OrgRole   @default(MEMBER)
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, email])
  @@index([tokenHash])
  @@index([orgId, acceptedAt])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ExternalConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  NEEDS_ATTENTION
  DISCONNECTED
  REVOKED
}

model ExternalConnection {
  id                String                    @id @default(cuid())
  orgId             String
  org               Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider          String
  sourceType        String
  sourceId          String
  externalAccountId String?
  displayName       String
  handle            String?
  status            ExternalConnectionStatus  @default(NOT_CONNECTED)
  statusOverride    ExternalConnectionStatus?
  credentialStatus  String                    @default("UNKNOWN")
  healthStatus      String                    @default("UNKNOWN")
  webhookStatus     String                    @default("UNKNOWN")
  lastCheckedAt     DateTime?
  lastError         String?                   @db.Text
  metadata          Json?

  capabilities  ExternalConnectionCapability[]
  permissions   ExternalConnectionPermission[]
  authorizationAttempts ExternalConnectionAuthorizationAttempt[]
  consumers     ExternalConnectionConsumer[]
  conversations Conversation[]
  calls         CommunicationCall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, sourceType, sourceId])
  @@index([orgId, status])
  @@index([orgId, provider])
}

model ExternalConnectionCapability {
  id             String             @id @default(cuid())
  connectionId   String
  connection     ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  key            String
  enabled        Boolean            @default(true)
  entitlementKey String?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, key])
  @@index([key, enabled])
}

model ExternalConnectionPermission {
  id                  String             @id @default(cuid())
  connectionId        String
  connection          ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  key                 String
  providerPermission  String?
  state               String
  requestable         Boolean            @default(false)
  reasonCode          String?
  authMode            String?
  verificationSource  String?
  observedAt          DateTime           @default(now())
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, key])
  @@index([connectionId, state])
  @@index([key, state])
}

model ExternalConnectionAuthorizationAttempt {
  id                    String             @id @default(cuid())
  connectionId          String
  connection            ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  orgId                 String
  userId                String
  provider              String
  authMode              String
  target                String
  state                 String             @unique
  requestedCapabilities String[]           @default([])
  status                String             @default("STARTED")
  failureCode           String?
  expiresAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([connectionId, status])
  @@index([orgId, expiresAt])
}

model ExternalConnectionConsumer {
  id           String             @id @default(cuid())
  connectionId String
  connection   ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  productKey   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, productKey])
  @@index([productKey])
}

/// Workspace-owned provider account. Product surfaces bind to the projected
/// ExternalConnection; OAuth material is never stored in Agents or exposed to
/// browser/model responses.
model EmailConnection {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  externalAccountId String
  emailAddress      String
  displayName       String
  accessToken       String   @db.Text
  refreshToken      String?  @db.Text
  tokenExpiresAt    DateTime?
  scopes            String[] @default([])
  status            String   @default("CONNECTED")
  healthStatus      String   @default("HEALTHY")
  syncStatus        String   @default("NOT_CONFIGURED")
  lastSyncedAt      DateTime?
  lastError         String?  @db.Text
  metadata          Json?

  oauthStates EmailOAuthState[]
  inboxBinding EmailInboxBinding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, provider, externalAccountId])
  @@index([orgId, provider])
  @@index([orgId, status])
  @@index([emailAddress])
}

/// Inbox's explicit binding to a workspace email account. The account and
/// credentials remain owned by EmailConnection; this row owns sync/readiness
/// state for the Inbox surface only.
model EmailInboxBinding {
  id                String         @id @default(cuid())
  orgId             String
  org               Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  emailConnectionId String         @unique
  emailConnection   EmailConnection @relation(fields: [emailConnectionId], references: [id], onDelete: Cascade)
  status            String         @default("ACTIVE")
  inboundStatus     String         @default("PENDING")
  outboundStatus    String         @default("PENDING")
  syncCursor        String?
  lastSyncedAt      DateTime?
  lastError         String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orgId, status])
  @@index([emailConnectionId, status])
}

model EmailOAuthState {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  stateHash   String   @unique
  redirectUri String
  returnPath  String   @default("/inbox")
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  emailConnectionId String?
  emailConnection   EmailConnection? @relation(fields: [emailConnectionId], references: [id], onDelete: SetNull)

  @@index([orgId, expiresAt])
  @@index([userId, provider])
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum OrganizationSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum EntitlementSource {
  PLAN
  TRIAL
  MANUAL
  MIGRATION
}

// ─── Product Access and Billing ────────────────────────────

model Product {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  active      Boolean @default(true)

  plans ProductPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductPlan {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  key              String          @unique
  name             String
  interval         BillingInterval @default(MONTHLY)
  currency         String          @default("ZAR")
  amountMinor      Int?
  creditsPerPeriod BigInt?
  active           Boolean         @default(false)
  paystackPlanCode String?         @unique

  entitlements     PlanEntitlement[]
  subscriptions    OrganizationSubscription[]
  billingCheckouts BillingCheckout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, active])
}

model UserProductTour {
  id          String       @id @default(cuid())
  userId      String
  orgId       String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status      String       @default("PENDING")
  currentStep Int          @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
}

model PlanEntitlement {
  id     String      @id @default(cuid())
  planId String
  plan   ProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  key    String
  value  Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, key])
  @@index([key])
}

model OrganizationSubscription {
  id                     String                         @id @default(cuid())
  orgId                  String
  org                    Organization                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   ProductPlan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                 OrganizationSubscriptionStatus @default(TRIAL)
  startedAt              DateTime                       @default(now())
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean                        @default(false)
  cancelledAt            DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?                        @unique
  billingInvoices        BillingInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status])
  @@index([planId, status])
}

model OrganizationEntitlementGrant {
  id          String            @id @default(cuid())
  orgId       String
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  source      EntitlementSource @default(MANUAL)
  startsAt    DateTime          @default(now())
  endsAt      DateTime?
  reason      String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, key, startsAt, endsAt])
}

model UsageEvent {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productKey     String
  metricKey      String
  quantity       Int          @default(1)
  sourceType     String?
  sourceId       String?
  idempotencyKey String?      @unique
  occurredAt     DateTime     @default(now())
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([orgId, productKey, metricKey, occurredAt])
}

model ReferralCode {
  id               String                @id @default(cuid())
  orgId            String                @unique
  code             String                @unique
  status           String                @default("ACTIVE")
  disabledAt       DateTime?
  disabledReason   String?
  attributedCount  Int                   @default(0)
  redemptionCount  Int                   @default(0)
  maxRedemptions   Int?
  org              Organization          @relation("ReferralCodeOwner", fields: [orgId], references: [id], onDelete: Cascade)
  attributions     ReferralAttribution[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
}

model ReferralAttribution {
  id                    String       @id @default(cuid())
  codeId                String
  referrerOrgId         String
  refereeOrgId          String       @unique
  status                String       @default("ATTRIBUTED")
  attributedAt          DateTime     @default(now())
  attributionExpiresAt  DateTime?
  qualifiedAt           DateTime?
  awardedAt             DateTime?
  reversedAt            DateTime?
  reversalReason        String?
  qualificationReference String?      @unique
  referrerRewardCredits Int?
  refereeRewardCredits  Int?
  rewardExpiryDays      Int?
  programVersion        String?
  referrerGrantId       String?
  refereeGrantId        String?
  metadata              Json?

  code       ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrer   Organization @relation("ReferralReferrer", fields: [referrerOrgId], references: [id], onDelete: Cascade)
  referee    Organization @relation("ReferralReferee", fields: [refereeOrgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([codeId, refereeOrgId])
  @@index([referrerOrgId, status])
  @@index([status, qualifiedAt])
  @@index([status, attributionExpiresAt])
}

model CreditAccount {
  id              String       @id @default(cuid())
  orgId           String       @unique
  balance         BigInt       @default(0)
  reservedBalance BigInt       @default(0)
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  grants          CreditGrant[]
  ledgerEntries   CreditLedgerEntry[]
  reservations    CreditReservation[]
  usageEvents     CreditUsageEvent[]
  adminOperations CreditAdminOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditGrant {
  id              String        @id @default(cuid())
  accountId       String
  orgId           String
  source          String
  amount          BigInt
  remainingAmount BigInt
  startsAt        DateTime      @default(now())
  endsAt          DateTime?
  reason          String?
  reference       String?
  createdByAdminId String?
  metadata        Json?

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerEntries CreditLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, endsAt, startsAt])
  @@index([accountId, remainingAmount])
}

model CreditLedgerEntry {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  grantId         String?
  type            String
  amount          BigInt
  balanceAfter    BigInt
  actionKey       String?
  sourceType      String?
  sourceId        String?
  idempotencyKey  String?  @unique
  pricingVersion  String?
  createdByAdminId String?
  metadata        Json?

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  grant   CreditGrant?  @relation(fields: [grantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([accountId, createdAt])
  @@index([orgId, type, createdAt])
}

model CreditReservation {
  id               String    @id @default(cuid())
  accountId        String
  orgId            String
  actionKey        String
  estimatedCredits BigInt
  capturedCredits  BigInt    @default(0)
  releasedCredits  BigInt    @default(0)
  status           String    @default("RESERVED")
  sourceType       String?
  sourceId         String?
  pricingVersion   String?
  idempotencyKey   String?   @unique
  expiresAt        DateTime?
  metadata         Json?

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, status, expiresAt])
  @@index([accountId, createdAt])
}

model CreditUsageEvent {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  ledgerEntryId   String?  @unique
  actionKey       String
  quantity        BigInt   @default(1)
  creditsCharged  BigInt
  status          String
  provider        String?
  model           String?
  fundingSource   String?
  inputTokens     BigInt?
  outputTokens    BigInt?
  providerCostUsd Decimal? @db.Decimal(18, 8)
  pricingVersion  String?
  idempotencyKey  String?  @unique
  metadata        Json?

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId, actionKey, createdAt])
  @@index([accountId, createdAt])
}

model CreditAdminOperation {
  id              String   @id @default(cuid())
  accountId       String
  orgId           String
  operationType   String
  amount          BigInt?
  source          String?
  reason          String
  reference       String?
  actorId         String
  beforeBalance   BigInt
  afterBalance    BigInt
  beforeReservedBalance BigInt @default(0)
  afterReservedBalance  BigInt @default(0)
  ledgerEntryId   String?
  idempotencyKey  String?  @unique
  status          String   @default("COMPLETED")
  metadata        Json?

  account CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([actorId, createdAt])
  @@index([operationType, createdAt])
}

model PublicApiRequest {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principalType  String
  principalId    String
  route          String
  method         String
  action         String?
  statusCode     Int
  correlationId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orgId, createdAt])
  @@index([orgId, principalId, createdAt])
  @@index([action, createdAt])
}

model DeveloperApiKey {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation("DeveloperApiKeysOrganization", fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  keyHash     String       @unique
  scopes      String[]     @default(["api:read", "api:write"])
  status      String       @default("ACTIVE")
  createdById String
  createdBy   User         @relation("DeveloperApiKeysCreated", fields: [createdById], references: [id], onDelete: Restrict)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model PublicApiWebhookSubscription {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url              String
  idempotencyKey   String?
  secretCiphertext String   @db.Text
  eventTypes       Json
  status           String   @default("ACTIVE")
  failureCount     Int      @default(0)
  lastDeliveredAt  DateTime?
  lastFailureAt    DateTime?
  disabledAt       DateTime?
  disabledReason   String?  @db.Text
  deliveries       PublicApiWebhookDelivery[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId, status])
  @@unique([orgId, idempotencyKey])
}

model PublicApiWebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   PublicApiWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventId        String
  eventType      String
  payload        Json
  status         String   @default("PENDING")
  attemptCount   Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastStatusCode Int?
  lastError      String?  @db.Text
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, createdAt])
}

model BillingCheckout {
  id                      String    @id @default(cuid())
  reference               String    @unique
  idempotencyKey          String?
  orgId                   String
  planId                  String
  userId                  String
  email                   String
  provider                String
  status                  String    @default("PENDING")
  authorizationUrl        String?
  providerTransactionId   String?
  providerAuthorizationId String?
  providerResponse        Json?
  completedAt             DateTime?

  org     Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan    ProductPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice BillingInvoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, provider, idempotencyKey])
  @@index([orgId, status])
  @@index([provider, providerTransactionId])
}

// An organisation-owned billing document. Provider identifiers are retained for
// reconciliation, while access continues to be derived from subscriptions and
// entitlements rather than this record.
model BillingInvoice {
  id                    String    @id @default(cuid())
  invoiceNumber         String    @unique
  orgId                 String
  checkoutId            String?   @unique
  subscriptionId        String?
  provider              String
  providerInvoiceId     String?
  providerTransactionId String?
  status                String    @default("PAID")
  currency              String
  amountMinor           Int?
  periodStart           DateTime?
  periodEnd             DateTime?
  issuedAt              DateTime  @default(now())
  paidAt                DateTime?

  org          Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checkout     BillingCheckout?          @relation(fields: [checkoutId], references: [id], onDelete: Restrict)
  subscription OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerInvoiceId])
  @@index([orgId, issuedAt])
  @@index([subscriptionId, periodStart])
}

model PaystackWebhookEvent {
  id           String    @id @default(cuid())
  eventKey     String    @unique
  eventType    String
  payload      Json
  status       String    @default("RECEIVED")
  errorMessage String?
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?

