  updatedAt DateTime @updatedAt
}

model OnboardingConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step          Int    @default(0)
  status        String @default("in_progress")
  messages      Json   @default("[]")
  extractedData Json?

