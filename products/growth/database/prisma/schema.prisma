model AdminSupportAccessAuditEvent {
  id        String                 @id @default(cuid())
  grantId   String
  actorId   String
  action    String
  metadata  Json                   @default("{}")
  createdAt DateTime               @default(now())

  grant AdminSupportAccessGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@index([grantId, createdAt])
}

model AdminWebhookReplayCommand {
  id                   String   @id @default(cuid())
  idempotencyKey       String   @unique
  deliveryId           String
  actorId              String
  customerId           String?
  customer             Organization? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  operationId          String? @unique
  requestDigest        String?
  reason               String?
  settledStatus        String?
  customerApprovals    AdminCustomerReplayApproval[]
  expectedStatus       String
  expectedAttemptCount Int
