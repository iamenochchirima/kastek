# Vite dev proxy. Production scripts/serve.mjs reads runtime process variables.
CORE_API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
GROWTH_WEB_ORIGIN=http://localhost:3000
GROWTH_CANONICAL_ORIGIN=https://growth.kasitek.co.za
# Set to 1 on preview deployments. Do not index preview hosts.
GROWTH_NOINDEX=1
# Public identifiers only. Set before building when WhatsApp embedded signup is enabled.
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
# API secrets and signing keys belong in server configuration, never VITE_* variables.
