{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "products/growth/web/Dockerfile",
    "watchPatterns": [
      "products/growth/web/**",
      "packages/contracts/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.shared.json",
      "packages/ui/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/__health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
