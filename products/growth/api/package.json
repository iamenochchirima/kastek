{
  "name": "@kasitek/growth-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --include .env src/bootstrap.ts",
    "start": "node dist/bootstrap.js",
    "test": "tsx --test tests/*.test.ts",
    "agents:setup": "tsx scripts/agent-setup.ts",
    "contracts:check": "tsx scripts/refresh-route-contracts.ts",
    "contracts:refresh": "tsx scripts/refresh-route-contracts.ts --write",
    "openapi:check": "tsx scripts/refresh-openapi.ts",
    "openapi:refresh": "tsx scripts/refresh-openapi.ts --write"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@kasitek-labs/contracts": "workspace:*",
    "@kasitek-labs/server-support": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "1.9.0",
    "@paralleldrive/cuid2": "^2.3.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "semver": "7.7.2",
    "undici": "8.11.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/semver": "7.7.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
