# Non-secret Core defaults for standalone local development.
# The root dotenv vault remains the source of local credentials.
ENVIRONMENT=development
PORT=4000
DATABASE_URL=postgresql://kasitek:replace-me@127.0.0.1:5432/kasitek_growth
DATABASE_MAX_CONNECTIONS=10
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
KASITEK_CORE_PUBLIC_URL=http://localhost:4000
KASITEK_MEDIA_STORAGE_PATH=.data/media
LOCAL_MAILPIT_URL=http://localhost:8025

# Human login values are documented in .env.identity.example.

# Configure these when the corresponding service is available.
# Embedded agents are optional. See Agents docs/growth-integration.md for both key directions.
# Production defaults to disabled. Enable reads/drafts first, then reviewed effects.
# GROWTH_AGENT_ACCESS_ENABLED=false
# GROWTH_AGENT_EFFECTS_ENABLED=false
# Comma-separated exact browser origins for external MCP clients; no wildcards.
# GROWTH_MCP_ALLOWED_ORIGINS=
# Keys stay server-side. FRONTEND_URL must exactly match Growth web GROWTH_WEB_ORIGIN.
# AGENTS_PRODUCT_API_URL=http://localhost:4100
# GROWTH_AGENTS_SIGNING_PRIVATE_KEY=
# GROWTH_AGENTS_KEY_ID=growth-v1
# GROWTH_AGENTS_ISSUER=https://growth.kasitek.co.za
# GROWTH_IDENTITY_ISSUER=https://growth.kasitek.co.za/identity
# AGENTS_PRODUCT_ACTION_PUBLIC_KEY=
# AGENTS_PRODUCT_ACTION_PUBLIC_KEYS_JSON=
# AGENTS_PRODUCT_ACTION_KEY_ID=agents-v1
# AGENTS_PRODUCT_ACTION_ISSUER=https://agents.kasitek.co.za
# ANALYTICS_INGESTION_URL=http://localhost:4300
# ANALYTICS_CORE_INGESTION_TOKEN=
# ANALYTICS_CORE_PRODUCER_ID=core-customer-analytics
# ANALYTICS_CORE_PUBLISHER_ID=core

# Run Core workers in a separate process when needed.
# KASITEK_DISABLE_BACKGROUND_WORKERS=1
# KASITEK_PROCESS=analytics-publisher

# Administrative reporting and product-scoped signed trend queries.
KASITEK_ADMIN_SERVICE_SECRET=
ANALYTICS_REPORTING_URL=http://127.0.0.1:4300
ANALYTICS_REPORTING_RESOLVER_TOKEN=
ANALYTICS_REPORTING_PRIVATE_KEY=
ANALYTICS_REPORTING_KEY_ID=
ANALYTICS_REPORTING_ISSUER=kasitek-core
ANALYTICS_REPORTING_AUDIENCE=kasitek-analytics-reporting

# Central billing service. When these are set, Growth customer billing routes,
# subscription actions, and entitlement checks move to the service. Unset values
# keep the legacy Growth billing implementation as the fallback.
# BILLING_SERVICE_URL=http://127.0.0.1:4500
# BILLING_SERVICE_SECRET=
# BILLING_SNAPSHOT_SECRET=
# BILLING_SERVICE_TIMEOUT_MS=3000

# Automatic organisation agent setup. Use an independent provisioning RSA key.
GROWTH_AGENTS_PROVISION_PRIVATE_KEY=
GROWTH_AGENTS_PROVISION_KEY_ID=growth-provision-v1
GROWTH_AGENTS_DEFAULT_MODEL_PROFILE_ID=growth-default
GROWTH_AGENTS_DEFAULT_MODEL_PROFILE_REVISION=1
# With API workers disabled, run KASITEK_PROCESS=growth-agent-setup-worker separately.
