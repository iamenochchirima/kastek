{
  "openapi": "3.1.0",
  "info": {
    "title": "KasiTek Public API",
    "version": "1.0.0",
    "description": "Versioned public core contracts. Business handlers reuse the shared action catalog and normalized request context."
  },
  "servers": [{ "url": "https://api.kasitek.co.za/v1" }],
  "security": [{ "kasitekSession": [] }, { "bearerInstallation": [] }, { "developerApiKey": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getApiHealth",
        "security": [],
        "responses": { "200": { "description": "Service health" } }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "version", "in": "query", "required": false, "schema": { "type": "string", "enum": ["v1"], "default": "v1" } }
        ],
        "responses": {
          "200": {
            "description": "Discoverable action catalog for the authenticated direct-user workspace",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityResponse" } } }
          },
          "401": { "description": "Missing or invalid KasiTek user session" },
          "400": { "description": "Invalid pagination or version" },
          "403": { "description": "Authenticated user has no available organization" },
          "500": { "description": "Entitlement or installation policy dependency unavailable" }
        }
      }
    },
    "/content/posts": {
      "get": {
        "operationId": "listContentPosts",
        "responses": {
          "200": { "description": "Organization-scoped content posts" },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      },
      "post": {
        "operationId": "createContentDraft",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": {
          "201": { "description": "Draft created" },
          "400": { "description": "Missing idempotency key or invalid draft" },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      }
    },
    "/content/posts/{id}": {
      "get": {
        "operationId": "getContentPost",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Organization-scoped content post" },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" },
          "404": { "description": "Content post not found" }
        }
      }
    },
    "/contacts": {
      "get": {
        "operationId": "listContacts",
        "parameters": [{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } }],
        "responses": {
          "200": { "description": "Redacted organization-scoped contacts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      }
    },
    "/inbox/conversations": {
      "get": {
        "operationId": "listInboxConversations",
        "responses": {
          "200": { "description": "Redacted organization-scoped inbox conversations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      }
    },
    "/inbox/conversations/{id}/messages": {
      "get": {
        "operationId": "listInboxMessages",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }],
        "responses": {
          "200": { "description": "Redacted conversation messages", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" },
          "404": { "description": "Conversation not found" }
        }
      }
    },
    "/bookings": {
      "get": {
        "operationId": "listBookings",
        "responses": {
          "200": { "description": "Organization-scoped bookings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      }
    },
    "/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "responses": {
          "200": { "description": "Redacted organization-scoped campaigns", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      }
    },
    "/campaigns/{id}": {
      "get": {
        "operationId": "getCampaignSummary",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } }],
        "responses": {
          "200": { "description": "Redacted campaign summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" },
          "404": { "description": "Campaign not found" }
        }
      }
    },
    "/templates": {
      "get": {
        "operationId": "listTemplates",
        "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED", "DISABLED"] } }],
        "responses": {
          "200": { "description": "Redacted organization-scoped templates", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceEnvelope" } } } },
          "401": { "description": "Missing or invalid principal" },
          "403": { "description": "Capability unavailable for principal" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "kasitekSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "KasiTek session token or Agent Platform installation token",
        "description": "A KasiTek user session or an Agent Platform ES256 installation token with audience kasitek-public-api. Configure AGENTS_INSTALLATION_TOKEN_PUBLIC_KEY on core before accepting machine tokens."
      },
      "bearerInstallation": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived Agent Platform installation token with audience kasitek-public-api."
      },
      "developerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "KasiTek workspace API key",
        "description": "Opaque workspace Developer API key. The raw key is shown once in Developers and is accepted as Authorization: Bearer kst_...."
      }
    },
    "schemas": {
      "CapabilityResponse": {
        "type": "object",
        "required": ["version", "principal", "actions", "pagination"],
        "properties": {
          "version": { "const": "v1" },
          "principal": { "type": "object", "required": ["kind", "id", "organizationId"], "properties": { "kind": { "enum": ["direct_user", "workspace_api_key", "agent_installation"] }, "id": { "type": "string" }, "organizationId": { "type": "string" } } },
          "actions": { "type": "array", "items": { "$ref": "#/components/schemas/Capability" } },
          "pagination": { "$ref": "#/components/schemas/CapabilityPagination" }
        }
      },
      "CapabilityPagination": {
        "type": "object",
        "required": ["limit", "cursor", "total", "version"],
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "integer", "minimum": 0 },
          "nextCursor": { "type": ["integer", "null"], "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "version": { "const": "v1" }
        }
      },
      "Capability": {
        "type": "object",
        "required": ["name", "version", "owningDomain", "title", "description", "inputSchema", "outputSchema", "risk", "approval", "idempotency"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "owningDomain": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "risk": { "type": "string" },
          "approval": { "type": "string" },
          "idempotency": { "type": "string" },
          "requiredGrants": { "type": "array", "items": { "type": "string" } },
          "requiredOAuthScopes": { "type": "array", "items": { "type": "string" } },
          "requiredEntitlements": { "type": "array", "items": { "type": "string" } },
          "dataClassification": { "type": "string" },
          "audit": { "type": "string" },
          "usage": { "type": "string" }
        }
      },
      "ResourceEnvelope": {
        "type": "object",
        "description": "Resource-specific envelope with sensitive provider and customer fields redacted by the core boundary.",
        "additionalProperties": true
      }
    }
  }
}
