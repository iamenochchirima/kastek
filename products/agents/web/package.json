{
  "name": "@kasitek/agent-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kasitek-labs/ui build && vite --host 127.0.0.1",
    "build": "pnpm --filter @kasitek-labs/ui build && tsc --noEmit && vite build",
    "lint": "eslint",
    "typecheck": "pnpm --filter @kasitek-labs/ui build && tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "test:ci": "playwright test --config playwright.ci.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "5.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "react-router-dom": "^7.0.0",
    "@fontsource/geist": "^5.0.0",
    "@fontsource/geist-mono": "^5.0.0",
    "@kasitek-labs/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "@playwright/test": "1.62.1"
  },
  "type": "module"
}
