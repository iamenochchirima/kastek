# Used only by the Vite dev proxy, never exposed as a VITE_ browser variable.
AGENTS_API_PROXY_TARGET=http://127.0.0.1:4100
# Sibling app destinations for the app switcher. Absolute https URLs in production.
# Local development falls back to http://localhost:3000 and http://localhost:3010.
VITE_GROWTH_APP_URL=
VITE_AGENCY_APP_URL=
