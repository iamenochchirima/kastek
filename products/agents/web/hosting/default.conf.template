server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Keep API errors out of the SPA fallback, including the bare /api path.
    location ~ ^(?:/api(?:/|$)|/mcp$|/oauth/(?:authorize|register|token|revoke)$|/\.well-known/oauth-(?:authorization-server|protected-resource)(?:/mcp)?$) {
        proxy_pass ${AGENTS_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_next_upstream off;
        proxy_redirect off;
    }

    # Vite fingerprints these files; missing assets should return 404.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
