{
  "name": "@kasitek/agents",
  "version": "0.1.0",
  "private": true,
  "description": "KasiTek Agent Platform API and durable worker",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kasitek/agent-platform dev",
    "build": "tsc -p tsconfig.json",
    "build:ui": "pnpm --filter @kasitek/agent-platform build",
    "lint:ui": "pnpm --filter @kasitek/agent-platform lint",
    "typecheck": "pnpm --filter @kasitek/agent-platform typecheck",
    "test:studio": "pnpm --filter @kasitek/agent-platform test:studio",
    "dev:api": "pnpm run migrate && tsx watch src/http/server.ts",
    "dev:discord": "tsx watch src/discord/server.ts",
    "dev:gateway": "tsx watch src/gateway/server.ts",
    "dev:stdio": "tsx src/gateway/stdio.ts",
    "build:mcp": "tsc -p packages/mcp/tsconfig.json",
    "dev:worker": "tsx watch src/temporal/worker.ts",
    "dev:analytics-publisher": "tsx watch src/analytics/publisher-worker.ts",
    "start:api": "node dist/http/server.js",
    "start:discord": "node dist/discord/server.js",
    "start:gateway": "node dist/gateway/server.js",
    "start:stdio": "node dist/gateway/stdio.js",
    "start:worker": "node dist/temporal/worker.js",
    "start:analytics-publisher": "node dist/analytics/publisher-worker.js",
    "test:e2e:local": "tsx scripts/local-e2e-smoke.ts",
    "test:telemetry:local": "tsx scripts/otel-local-smoke.ts",
    "test:telemetry:collector-unavailable": "tsx scripts/otel-collector-unavailable-smoke.ts http-503 && tsx scripts/otel-collector-unavailable-smoke.ts connection-refused",
    "release:memory:manifest": "tsx scripts/release-memory-manifest.ts",
    "release:memory:verify": "tsx scripts/verify-memory-release-manifest.ts",
    "prepare:shared": "node scripts/prepare-shared.mjs",
    "generate:capabilities": "tsx scripts/generate-capability-docs.ts",
    "migrate": "tsx src/db/migrate.ts",
    "bootstrap:kasiai": "tsx src/system/bootstrap-kasiai.ts",
    "release:kasiai": "tsx src/system/release-kasiai.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kasitek-labs/contracts": "file:.artifacts/shared/kasitek-labs-contracts-0.2.0.tgz",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "10.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-pino": "^0.67.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@temporalio/activity": "^1.13.0",
    "@temporalio/client": "^1.13.0",
    "@temporalio/worker": "^1.13.0",
    "@temporalio/workflow": "^1.13.0",
    "ajv": "^8.17.1",
    "fastify": "^5.4.0",
    "mammoth": "1.12.1",
    "openid-client": "^6.8.8",
    "pdf-parse": "2.4.5",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "xlsx": "0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
