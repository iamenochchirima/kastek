{
  "schemaVersion": 1,
  "connectors": [
    {
      "id": "google-calendar",
      "revision": 1,
      "profileId": "google-calendar-v1",
      "adapterKey": "google-calendar-v1",
      "kind": "native_api",
      "name": "Google Calendar",
      "description": "Check availability and create confirmed appointments in a selected calendar.",
      "publisher": {
        "id": "kasitek",
        "name": "KasiTek",
        "verified": true
      },
      "auth": {
        "kind": "oidc",
        "issuer": "https://accounts.google.com",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "jwksUri": "https://www.googleapis.com/oauth2/v3/certs",
        "scopes": [
          "openid",
          "email",
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events"
        ],
        "callbackPath": "/api/google-calendar/callback",
        "environment": {
          "clientId": "GOOGLE_CALENDAR_CLIENT_ID",
          "clientSecret": "GOOGLE_CALENDAR_CLIENT_SECRET",
          "callbackUrl": "GOOGLE_CALENDAR_CALLBACK_URL"
        }
      },
      "apiBaseUrl": "https://www.googleapis.com/calendar/v3",
      "catalogue": {
        "purposes": [
          "booking",
          "customer-service"
        ],
        "products": [
          "agents"
        ],
        "executionKinds": [
          "business"
        ],
        "permissions": [
          "agent.configure",
          "calendar.configure"
        ],
        "selection": {
          "kind": "capability",
          "capability": "businessActions",
          "profileId": "google-calendar-booking-v1",
          "setup": "booking"
        },
        "configurationRequired": {
          "code": "BOOKING_POLICY_REQUIRED",
          "message": "Choose a shared calendar and configure appointment rules."
        },
        "unavailable": {
          "code": "GOOGLE_OAUTH_NOT_CONFIGURED",
          "message": "Google Calendar is unavailable until the server OAuth client is configured."
        }
      },
      "setup": {
        "kind": "calendar_service",
        "apiPath": "google-calendar",
        "identityLabel": "Google"
      }
    },
