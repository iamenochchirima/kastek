NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Use a new dedicated database. Setup refuses databases containing other schemas.
AGENTS_DATABASE_URL=postgresql://agents:replace-password@127.0.0.1:5432/agents_platform
# Optional separate DDL credential for setup only.
# AGENTS_MIGRATION_DATABASE_URL=
AGENTS_PUBLIC_URL=http://localhost:3100
AGENTS_OIDC_ISSUER_URL=http://localhost:8080/realms/kasitek
AGENTS_OIDC_CLIENT_ID=agents
# Independent secret from infra/identity/.env; minimum 24 characters.
AGENTS_OIDC_CLIENT_SECRET=
# Optional independent signing key, minimum 32 characters. Never reuse the OIDC secret.
# Without this, return destinations fall back to /app after an API restart.
# AGENTS_LOGIN_RETURN_SECRET=
# Central billing. Required when AGENTS_BILLING_ENFORCEMENT is enabled.
# BILLING_SERVICE_URL=http://127.0.0.1:4500
# BILLING_SERVICE_SECRET=
# BILLING_SNAPSHOT_SECRET=
# AGENTS_BILLING_ENFORCEMENT=1

# Optional managed starter model. Owner workspace bootstrap stores a scoped encrypted
# OpenRouter connection/default; execution still uses normal workspace model authority.
# Existing defaults and revoked/removed managed connections are never overwritten.
# OPENROUTER_API_KEY=
# Set false to disable new-workspace initialization without changing existing defaults.
AGENTS_DEFAULT_MODEL_ENABLED=true
# Dedicated key overrides OPENROUTER_API_KEY for new managed connections.
# AGENTS_DEFAULT_MODEL_API_KEY=
# Must be discovered with known-zero input/output prices.
AGENTS_DEFAULT_MODEL_ID=nvidia/nemotron-3.5-lightning:free
RESTATE_INGRESS_URL=http://127.0.0.1:18080
RESTATE_ADMIN_URL=http://127.0.0.1:19070
RESTATE_WORKER_PORT=9080
RESTATE_WORKER_HOST=127.0.0.1
# Production requires the cluster's comma-separated publickeyv1_ request keys.
# RESTATE_REQUEST_IDENTITY_KEYS=
# Docker development may need 0.0.0.0 for the private worker bridge.
# Explicit opt-in applies only outside production; never expose the worker publicly.
# AGENTS_ALLOW_UNSIGNED_WORKER=1
# Restate must reach this private endpoint; register before dispatching work.
RESTATE_WORKER_URL=http://host.docker.internal:9080

# Optional Agents-owned customer reply notifications. Configure the same sender/key/public URL
# on API and worker, apply schema085 and register AgentsCustomerFollowupV1 before enabling.
# The sender must be verified with Resend. No Identity or other product credentials are reused.
# AGENTS_FOLLOWUP_RESEND_API_KEY=
# AGENTS_FOLLOWUP_EMAIL_SENDER=support@example.com

# Optional private S3-compatible artifact storage. Configure all five together.
# Provision a private bucket separately. Missing storage has no local fallback.
# AGENTS_S3_ENDPOINT=http://127.0.0.1:9000
# AGENTS_S3_REGION=us-east-1
# AGENTS_S3_BUCKET=agents-private
# AGENTS_S3_ACCESS_KEY_ID=
# AGENTS_S3_SECRET_ACCESS_KEY=

# Optional verified Linux x86_64 gVisor analysis profile. Prepare the pinned runtime first.
# Run an independent sandbox reaper alongside the API/worker before enabling this.
AGENTS_SANDBOX_ENABLED=0
# AGENTS_SANDBOX_RUNSC=/absolute/path/to/gvisor/runsc
# AGENTS_SANDBOX_ROOTFS=/absolute/path/to/python-rootfs
# AGENTS_SANDBOX_DIRECTORY=/absolute/private/path/to/allocations

# Optional report and GitHub connection profiles. Store the keyring outside the database.
# Each base64 key must contain exactly 32 random bytes; never commit actual keys.
# AGENTS_CONNECTION_ACTIVE_KEY=local-v1
# AGENTS_CONNECTION_KEYS={"local-v1":"<base64-key>"}
# Explicitly configured destinations only; HTTPS in production, no redirects.
# AGENTS_REPORT_DELIVERY_TARGETS=[{"id":"reports","label":"Reports","url":"https://receiver.example/deliveries","resource":"workspace-reports"}]

# Optional document ingestion and local semantic retrieval. Prepare document-prepare.sh first.
# Requires private S3 storage and the document/source-object reapers.
AGENTS_DOCUMENT_RUNTIME_ENABLED=0
# AGENTS_DOCUMENT_RUNTIME_CACHE=/absolute/private/path/to/kasitek-documents
# Acceptance only: approved expiring read-only GitHub token; never exposed to the model.
# AGENTS_GITHUB_ACCEPTANCE_TOKEN=
# AGENTS_GITHUB_ACCEPTANCE_EXPIRES_AT=

# Optional Google Calendar connector. Register this exact callback in your OAuth app.
# Match the callback origin to AGENTS_PUBLIC_URL. Keep real values in private .env only.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:3100/api/google-calendar/callback

# Optional Microsoft 365 Calendar and HubSpot native connectors. Each callback must
# match AGENTS_PUBLIC_URL and its registered app. All require the encrypted keyring.
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CALLBACK_URL=http://localhost:3100/api/providers/microsoft-calendar/callback
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_CALLBACK_URL=http://localhost:3100/api/providers/hubspot/callback

# Optional MCP OAuth registration; provider values stay in separate environment variables.
# AGENTS_MCP_OAUTH_CLIENTS=[{"issuer":"https://provider.example","clientIdEnvironment":"PROVIDER_CLIENT_ID","clientSecretEnvironment":"PROVIDER_CLIENT_SECRET","authMethod":"client_secret_post"}]
# PROVIDER_CLIENT_ID=
# PROVIDER_CLIENT_SECRET=
# Optional public HTTPS client document for servers supporting CIMD.
# AGENTS_MCP_CLIENT_METADATA_URL=

# Optional private Stash acceptance only. Never expose the key to the model or browser.
# STASH_AGENT_KEY=
# AGENTS_STASH_ACCEPTANCE_ITEM_ID=
# AGENTS_STASH_ACCEPTANCE_EXPECT=
# Local Agents connection window, not the manual Stash key expiry. Defaults to 30 days.
# AGENTS_STASH_CONNECTION_EXPIRES_AT=
# Public repository acceptance needs no provider key. Default: modelcontextprotocol/typescript-sdk main README.md.
# AGENTS_PUBLIC_REPOSITORY_JOURNEY=1

# Optional embedded Growth execution. The two directions use separate RSA keypairs.
# Growth API command verifier: SPKI public PEM or a kid -> PEM JSON keyring.
# GROWTH_AGENTS_PUBLIC_KEY=
# GROWTH_AGENTS_PUBLIC_KEYS_JSON=
# GROWTH_AGENTS_KEY_ID=growth-v1
# GROWTH_AGENTS_ISSUER=https://growth.kasitek.co.za
# GROWTH_IDENTITY_ISSUER=https://growth.kasitek.co.za/identity
# Optional separate control-plane public keyring; never give its private key to Growth web.
# GROWTH_AGENTS_CONTROL_PUBLIC_KEYS_JSON=
# GROWTH_AGENTS_CONTROL_CLIENT_ID=growth-control

# Agency execution is independent of Growth service configuration.
# AGENCY_PRODUCT_API_URL=http://127.0.0.1:8090
# AGENCY_AGENTS_ISSUER=https://agency.kasitek.co.za
# AGENCY_IDENTITY_ISSUER=https://agency.kasitek.co.za/identity
# AGENCY_AGENTS_PUBLIC_KEY=
# AGENCY_AGENTS_KEY_ID=agency-v1
# AGENCY_AGENTS_PUBLIC_KEYS_JSON=
# AGENCY_AGENTS_CONTROL_PUBLIC_KEYS_JSON=
# Destination action signer used by API preflight and the shared worker.
# GROWTH_PRODUCT_API_URL=http://127.0.0.1:4000
# AGENTS_PRODUCT_ACTION_PRIVATE_KEY=
# AGENTS_PRODUCT_ACTION_KEY_ID=agents-v1
# AGENTS_PRODUCT_ACTION_ISSUER=https://agents.kasitek.co.za

# Explicit operator setup only: pnpm setup:growth-model. Requires the vault above.
# Never a runtime environment-key fallback. Keep all real keys in private configuration.
# GROWTH_MODEL_TENANT_ID=
# GROWTH_MODEL_PROVIDER_ID=openrouter
# GROWTH_MODEL_ID=
# GROWTH_MODEL_API_KEY=
# Optional approved provider endpoint; model setup validates it.
# GROWTH_MODEL_ENDPOINT=
# Operator lifecycle control only: pnpm control:growth.
# GROWTH_CONTROL_TENANT_ID=
# GROWTH_CONTROL_ACTION=tenant.disable
# Platform root-admission drain only: pnpm control:admissions.
# AGENTS_ADMISSION_CONTROL_ACTION=drain
# AGENTS_ADMISSION_CONTROL_ACTOR=operator-name
# AGENTS_ADMISSION_CONTROL_REASON=planned-release
# Set from the current agents_platform.platform_admission_gate.revision before each control command.
# AGENTS_ADMISSION_CONTROL_EXPECTED_REVISION=

# Labs admin reads and native durable Analytics publication. Keep keys server-side.
KASITEK_ADMIN_SERVICE_SECRET=
ANALYTICS_REPORTING_URL=http://127.0.0.1:4300
# Both absent disables native publication; configure both to enable it.
AGENTS_ANALYTICS_INGESTION_URL=
AGENTS_ANALYTICS_INGESTION_TOKEN=

# Growth organisation setup is separate from human conversation/configuration authority.
GROWTH_AGENTS_PROVISION_PUBLIC_KEYS_JSON=
# Explicit JSON: id, revision, providerId, modelId, credentialRef, optional endpoint.
# credentialRef names a protected variable such as GROWTH_MODEL_DEFAULT_API_KEY below.
GROWTH_MANAGED_MODEL_PROFILE_JSON=
GROWTH_MODEL_DEFAULT_API_KEY=

# Optional website crawl provider. One adapter supports self-hosted and Cloud v2 APIs.
# Local: http://127.0.0.1:3002; Cloud: https://api.firecrawl.dev plus a server-side key.
AGENTS_FIRECRAWL_URL=
AGENTS_FIRECRAWL_API_KEY=
AGENTS_FIRECRAWL_TIMEOUT_MS=60000

# Private organization assistant phone access; empty disables admissions and delivery.
# Configure the same explicit organization UUID allowlist on API and worker.
AGENTS_MEMBER_ASSISTANT_ORGANIZATIONS=

# Operator-reviewed provider account/endpoint evidence; see docs/operations/provider-data-controls.md
# AGENTS_PROVIDER_DATA_POLICY_FILE=/private/provider-policy.json
# AGENTS_PROVIDER_DATA_POLICY_EXPECTED_REVISION=0
