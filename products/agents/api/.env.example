NODE_ENV=development
HOST=127.0.0.1
PORT=4100
# Use a new dedicated database. Setup refuses databases containing other schemas.
AGENTS_DATABASE_URL=postgresql://agents:replace-password@127.0.0.1:5432/agents_platform
# Optional separate DDL credential for setup only.
# AGENTS_MIGRATION_DATABASE_URL=
AGENTS_PUBLIC_URL=http://localhost:3100
AGENTS_OIDC_ISSUER_URL=http://localhost:8080/realms/kasitek
AGENTS_OIDC_CLIENT_ID=agents
# Independent secret from infra/identity/.env; minimum 24 characters.
AGENTS_OIDC_CLIENT_SECRET=
# Development uses only nvidia/nemotron-3-super-120b-a12b:free; no paid fallback.
# The model profile disables reasoning and uses conservative request accounting.
OPENROUTER_API_KEY=
RESTATE_INGRESS_URL=http://127.0.0.1:18080
RESTATE_ADMIN_URL=http://127.0.0.1:19070
RESTATE_WORKER_PORT=9080
RESTATE_WORKER_HOST=127.0.0.1
# Production requires the cluster's comma-separated publickeyv1_ request keys.
# RESTATE_REQUEST_IDENTITY_KEYS=
# Docker development may need 0.0.0.0 for the private worker bridge.
# Explicit opt-in applies only outside production; never expose the worker publicly.
# AGENTS_ALLOW_UNSIGNED_WORKER=1
# Restate must reach this private endpoint; register before dispatching work.
RESTATE_WORKER_URL=http://host.docker.internal:9080

# Optional private S3-compatible artifact storage. Configure all five together.
# Provision a private bucket separately. Missing storage has no local fallback.
# AGENTS_S3_ENDPOINT=http://127.0.0.1:9000
# AGENTS_S3_REGION=us-east-1
# AGENTS_S3_BUCKET=agents-private
# AGENTS_S3_ACCESS_KEY_ID=
# AGENTS_S3_SECRET_ACCESS_KEY=

# Optional verified Linux x86_64 gVisor analysis profile. Prepare the pinned runtime first.
# Run an independent sandbox reaper alongside the API/worker before enabling this.
AGENTS_SANDBOX_ENABLED=0
# AGENTS_SANDBOX_RUNSC=/absolute/path/to/gvisor/runsc
# AGENTS_SANDBOX_ROOTFS=/absolute/path/to/python-rootfs
# AGENTS_SANDBOX_DIRECTORY=/absolute/private/path/to/allocations

# Optional reviewed report delivery. Store the keyring outside the database.
# Each base64 key must contain exactly 32 random bytes; never commit actual keys.
# AGENTS_CONNECTION_ACTIVE_KEY=local-v1
# AGENTS_CONNECTION_KEYS={"local-v1":"<base64-key>"}
# Explicitly configured destinations only; HTTPS in production, no redirects.
# AGENTS_REPORT_DELIVERY_TARGETS=[{"id":"reports","label":"Reports","url":"https://receiver.example/deliveries","resource":"workspace-reports"}]
