{
  "name": "@kasitek/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agents platform API and Restate business worker",
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @kasitek/agent-platform dev",
    "dev:api": "pnpm setup:db && node --env-file-if-exists=.env --import tsx --watch src/composition/server.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch src/composition/worker.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:ui": "pnpm --filter @kasitek/agent-platform build",
    "lint:ui": "pnpm --filter @kasitek/agent-platform lint",
    "start:api": "node --env-file-if-exists=.env dist/composition/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/composition/worker.js",
    "setup:db": "node --env-file-if-exists=.env --import tsx src/composition/setup.ts",
    "typecheck:api": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:runtime": "bash ../../../infra/agents-runtime/verify.sh",
    "dev:sandbox-reaper": "node --env-file-if-exists=.env --import tsx src/composition/sandbox-reaper.ts",
    "start:sandbox-reaper": "node --env-file-if-exists=.env dist/composition/sandbox-reaper.js",
    "dev:document-reaper": "node --env-file-if-exists=.env --import tsx src/composition/document-reaper.ts",
    "start:document-reaper": "node --env-file-if-exists=.env dist/composition/document-reaper.js",
    "dev:source-object-reaper": "node --env-file-if-exists=.env --import tsx src/composition/source-object-reaper.ts",
    "start:source-object-reaper": "node --env-file-if-exists=.env dist/composition/source-object-reaper.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@restatedev/restate-sdk": "1.17.3",
    "fastify": "^5.4.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.1.0",
    "openid-client": "^6.8.8",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
