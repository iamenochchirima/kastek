  "tools": [
    {
      "name": "search_resources",
      "description": "Legacy link-only search. For links, notes, ideas and PDFs use search_items.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "collectionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "unread",
              "reading",
              "done"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000,
            "default": 0
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "stash:read"
          ]
        }
      ]
    },
