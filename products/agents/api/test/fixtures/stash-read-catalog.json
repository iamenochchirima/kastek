    {
      "name": "get_item",
      "description": "Read a private item by ID, including full library note/idea content. Project bodies are capped at 50,000 characters with bodyTruncated; use read_project_document to continue. Trashed items require an explicit trash request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trash": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
