generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ─── Organizations ─────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  ownerId     String

  owner       User     @relation("OwnedOrganizations", fields: [ownerId], references: [id], onDelete: Restrict)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  botConfigurations        BotConfiguration[]
  botEvents                BotEvent[]
  botDeployments           BotDeployment[]
  socialChannelConnections SocialChannelConnection[]
  socialPosts              SocialPost[]
  socialPublishJobs        SocialPublishJob[]
  whatsappConnections      WhatsappConnection[]
  whatsappContacts         WhatsappContact[]
  whatsappContactListMemberships WhatsappContactListMembership[]
  whatsappTemplates        WhatsappTemplate[]
  whatsappCampaigns        WhatsappCampaign[]
  whatsappSendEvents       WhatsappSendEvent[]
  whatsappCallSessions     WhatsappCallSession[]
  conversations            Conversation[]
  subscriptions            OrganizationSubscription[]
  entitlementGrants        OrganizationEntitlementGrant[]
  usageEvents              UsageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model OrganizationMember {
  id     String @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(MEMBER)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
}

model OrganizationInvitation {
  id           String   @id @default(cuid())
  orgId        String
  email        String
  role         OrgRole  @default(MEMBER)
  token        String   @unique @default(cuid())
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, email])
  @@index([token])
  @@index([orgId, acceptedAt])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum OrganizationSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum EntitlementSource {
  PLAN
  TRIAL
  MANUAL
  MIGRATION
}

// ─── Product Access and Billing ────────────────────────────

model Product {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  active      Boolean  @default(true)

  plans       ProductPlan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductPlan {
  id                  String          @id @default(cuid())
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  key                 String          @unique
  name                String
  interval            BillingInterval @default(MONTHLY)
  currency            String          @default("ZAR")
  amountMinor         Int?
  active              Boolean         @default(false)
  paystackPlanCode    String?         @unique

  entitlements        PlanEntitlement[]
  subscriptions       OrganizationSubscription[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([productId, active])
}

model PlanEntitlement {
  id          String      @id @default(cuid())
  planId      String
  plan        ProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  key         String
  value       Json

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([planId, key])
  @@index([key])
}

model OrganizationSubscription {
  id                    String                         @id @default(cuid())
  orgId                 String
  org                   Organization                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId                String
  plan                  ProductPlan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                OrganizationSubscriptionStatus @default(TRIAL)
  startedAt             DateTime                       @default(now())
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  trialEndsAt           DateTime?
  cancelAtPeriodEnd     Boolean                        @default(false)
  cancelledAt           DateTime?
  provider              String?
  providerCustomerId    String?
  providerSubscriptionId String?                       @unique

  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([orgId, status])
  @@index([planId, status])
}

model OrganizationEntitlementGrant {
  id          String             @id @default(cuid())
  orgId       String
  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  key         String
  value       Json
  source      EntitlementSource  @default(MANUAL)
  startsAt    DateTime           @default(now())
  endsAt      DateTime?
  reason      String?
  createdById String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([orgId, key, startsAt, endsAt])
}

model UsageEvent {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  productKey     String
  metricKey      String
  quantity       Int          @default(1)
  sourceType     String?
  sourceId       String?
  idempotencyKey String?      @unique
  occurredAt     DateTime     @default(now())
  metadata       Json?

  createdAt      DateTime     @default(now())

  @@index([orgId, productKey, metricKey, occurredAt])
}

// ─── Auth.js Required Tables (Client App) ─────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?

  accounts      Account[]
  sessions      Session[]

  ownedOrganizations   Organization[]         @relation("OwnedOrganizations")
  orgMemberships       OrganizationMember[]
  sentInvitations      OrganizationInvitation[] @relation("SentInvitations")

  businessProfile   BusinessProfile?
  botConfigurations BotConfiguration[]
  botEvents         BotEvent[]
  botDeployments    BotDeployment[]
  conversations     OnboardingConversation[]
  socialChannelConnections SocialChannelConnection[]
  socialPosts              SocialPost[]
  socialPublishJobs        SocialPublishJob[]
  whatsappConnections WhatsappConnection[]
  whatsappContacts    WhatsappContact[]
  whatsappContactListMemberships WhatsappContactListMembership[]
  whatsappTemplates   WhatsappTemplate[]
  whatsappCampaigns   WhatsappCampaign[]
  whatsappSendEvents  WhatsappSendEvent[]
  whatsappCallSessions WhatsappCallSession[]
  pushSubscriptions   PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique @db.Text
  p256dh         String   @db.Text
  auth           String   @db.Text
  expirationTime BigInt?
  userAgent      String?  @db.Text
  lastUsedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Admin Users (Separate from Client Users) ─────────────

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // superadmin | admin | viewer

  assignedLeads QuoteRequest[] @relation("AssignedLeads")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── KasiTek Domain Tables ──────────────────────────────────

model BusinessProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName   String
  businessType   String
  industry       String?
  description    String?  @db.Text

  address    String?
  city       String?
  province   String?
  postalCode String?
  country    String @default("ZA")

  phone          String?
  whatsappNumber String?
  website        String?

  operatingHours      Json?
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BotConfiguration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  name   String
  type   String
  status String @default("draft")

  greetingMessage String? @db.Text
  personality     String?
  language        String  @default("en")

  capabilities      Json?
  knowledgeBase     Json?
  integrationConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events BotEvent[]
  deployments BotDeployment[]

  @@index([userId])
  @@index([orgId])
}

model BotEvent {
  id      String @id @default(cuid())
  botId   String
  bot     BotConfiguration @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId  String
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId   String?
  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  eventType      String
  channel        String?
  status         String?
  conversationId String?
  responseTimeMs Int?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([orgId, createdAt])
}

model BotDeployment {
  id     String @id @default(cuid())
  botId  String
  bot    BotConfiguration @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  provider         String
  target           String
  status           String
  versionNumber    Int
  workflowId       String?
  templateKey      String?
  configSnapshot   Json?
  responsePayload  Json?
  errorMessage     String? @db.Text
  deployedAt       DateTime?
  pausedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([botId, createdAt])
  @@index([userId, createdAt])
  @@index([orgId, createdAt])
}

model OnboardingConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step          Int    @default(0)
  status        String @default("in_progress")
  messages      Json   @default("[]")
  extractedData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Quote / Lead Capture ────────────────────────────────────

model QuoteRequest {
  id            String   @id @default(cuid())
  businessName  String
  contactPerson String
  phone         String
  email         String
  businessType  String
  services      String[]
  description   String?  @db.Text

  // Lead management fields
  source        String   @default("website") // website | facebook | linkedin | cold_email | referral | whatsapp | walk_in
  status        String   @default("new")     // new | contacted | interested | quoted | won | lost
  quoteAmount   Float?
  followUpDate  DateTime?
  notes         Json     @default("[]")      // Array of {text, timestamp, adminUserId, adminUserName}

  assignedToId  String?
  assignedTo    AdminUser? @relation("AssignedLeads", fields: [assignedToId], references: [id])
  quotations    Quotation[]
  invoices      Invoice[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedToId])
}

model ProductWaitlistEntry {
  id            String   @id @default(cuid())
  businessName  String
  contactPerson String
  phone         String?
  email         String
  businessType  String?
  products      String[]
  notes         String?  @db.Text
  source        String   @default("website")
  status        String   @default("new")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([source])
}

model Quotation {
  id                    String   @id @default(cuid())
  businessName          String
  contactPerson         String
  contactEmail          String
  contactPhone          String
  date                  DateTime
  serviceType           String   @default("website_agent")
  title                 String
  introduction          String?  @db.Text
  scopeOfWork           Json     @default("[]")
  deliverables          Json     @default("[]")
  implementationSteps   Json     @default("[]")
  pricingItems          Json     @default("[]")
  maintenanceIncludes   Json     @default("[]")
  termsAndNotes         Json     @default("[]")
  includedFunctionality Json     @default("[]")
  knowledgeBaseScope    Json     @default("[]")
  importantNotes        Json     @default("[]")
  supportIncludes       Json     @default("[]")
  setupFee              String
  monthlyFee            String
  deliveryTimeline      String?
  validityDays          Int      @default(14)
  status                String   @default("draft") // draft | sent | accepted | rejected | expired

  quoteRequestId        String?
  quoteRequest          QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([quoteRequestId])
}

model Invoice {
  id                    String   @id @default(cuid())
  businessName          String
  contactPerson         String
  contactEmail          String
  contactPhone          String
  date                  DateTime
  serviceType           String   @default("website_agent")
  billingMode           String   @default("one_off")
  recurringActive       Boolean  @default(false)
  billingAnchorDay      Int?
  reminderDaysAfterDue  Int      @default(3)
  lastSentAt            DateTime?
  lastReminderAt        DateTime?
  lastPaidAt            DateTime?
  title                 String
  introduction          String?  @db.Text
  scopeOfWork           Json     @default("[]")
  deliverables          Json     @default("[]")
  implementationSteps   Json     @default("[]")
  pricingItems          Json     @default("[]")
  maintenanceIncludes   Json     @default("[]")
  termsAndNotes         Json     @default("[]")
  includedFunctionality Json     @default("[]")
  knowledgeBaseScope    Json     @default("[]")
  importantNotes        Json     @default("[]")
  supportIncludes       Json     @default("[]")
  setupFee              String
  monthlyFee            String
  deliveryTimeline      String?
  validityDays          Int      @default(14)
  status                String   @default("draft") // draft | sent | paid | overdue | cancelled

  quoteRequestId        String?
  quoteRequest          QuoteRequest? @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)
  runs                  InvoiceRun[]

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([quoteRequestId])
  @@index([billingMode, recurringActive])
}

model InvoiceRun {
  id                    String   @id @default(cuid())
  invoiceId             String
  invoice               Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cycleKey              String
  issueDate             DateTime
  periodStart           DateTime
  periodEnd             DateTime
  dueDate               DateTime
  status                String   @default("pending") // pending | sent | reminder_due | reminder_sent | paid | overdue | cancelled
  sendStatus            String   @default("pending") // pending | sent
  reminderStatus        String   @default("not_needed") // not_needed | pending | sent
  sentAt                DateTime?
  reminderDueAt         DateTime?
  reminderSentAt        DateTime?
  paidAt                DateTime?
  pricingItemsSnapshot  Json     @default("[]")
  titleSnapshot         String
  contactEmailSnapshot  String
  businessNameSnapshot  String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([invoiceId, cycleKey])
  @@index([invoiceId, issueDate])
  @@index([status, dueDate])
  @@index([sendStatus, issueDate])
  @@index([reminderStatus, reminderDueAt])
}

// ─── Outreach / Cold Email Campaigns ─────────────────────────

model OutreachCampaign {
  id         String   @id @default(cuid())
  name       String   // e.g. "Restaurants Feb 2026"
  category   String   // bizbay category slug
  status     String   @default("draft") // draft | active | paused | completed
  totalLeads Int      @default(0)
  emailsSent Int      @default(0)
  replies    Int      @default(0)

  leads OutreachLead[]
  deliveryLogs OutreachEmailDeliveryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutreachLead {
  id         String           @id @default(cuid())
  campaignId String
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  businessName String
  website      String?
  address      String?
  bizbayUrl    String?
  category     String

  phone         String?

  // Email outreach tracking
  emailStatus   String    @default("pending") // pending | sent | replied | interested | not_interested | bounced
  emailAddress  String?
  emailSentAt   DateTime?
  emailTemplate String?
  followUpCount Int       @default(0)
  lastFollowUp  DateTime?
  nextFollowUp  DateTime?

  notes String? @db.Text
  deliveryLogs OutreachEmailDeliveryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([emailStatus])
}

model OutreachEmailDeliveryLog {
  id         String   @id @default(cuid())
  campaignId String?
  campaign   OutreachCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  leadId     String?
  lead       OutreachLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  isTest     Boolean  @default(false)

  recipient         String
  subject           String
  status            String   // sent | failed
  provider          String   @default("smtp")
  providerMessageId String?
  providerResponse  String?  @db.Text
  errorMessage      String?  @db.Text
  attemptedAt       DateTime @default(now())

  @@index([campaignId, attemptedAt])
  @@index([leadId, attemptedAt])
  @@index([status])
  @@index([isTest, attemptedAt])
}

// ─── Web Services Leads (Cold Call) ──────────────────────────

model WebServiceLead {
  id           String   @id @default(cuid())
  businessName String
  website      String?
  address      String?
  category     String
  bizbayUrl    String?
  phone        String?
  email        String?

  callStatus   String   @default("pending") // pending | called | interested | not_interested | no_answer | callback
  notes        String?  @db.Text
  callbackDate DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([callStatus])
  @@index([category])
}

// ─── Chatbot Conversations ───────────────────────────────────

model Conversation {
  id                 String   @id @default(cuid())
  channel            String   // whatsapp | website
  customerIdentifier String   // phone number or session ID
  customerName       String?
  status             String   @default("active") // active | closed
  lastMessageAt      DateTime @default(now())
  lastReadAt         DateTime?
  unreadCount        Int      @default(0)

  orgId              String?
  org                Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  messages     Message[]
  callSessions WhatsappCallSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, customerIdentifier])
  @@index([channel])
  @@index([orgId, lastMessageAt])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // customer | bot
  content        String       @db.Text
  providerMessageId String?
  providerStatus    String?
  providerMetadata  Json?
  whatsappMessageId String?
  whatsappStatus    String?
  whatsappConversationId      String?
  whatsappConversationOrigin  String?
  whatsappConversationExpires DateTime?
  whatsappPricingBillable     Boolean?
  whatsappPricingCategory     String?
  whatsappPricingModel        String?
  whatsappPricingType         String?
  errorCode         String?
  errorMessage      String?   @db.Text
  timestamp      DateTime     @default(now())

  @@index([conversationId])
  @@index([providerMessageId])
  @@index([providerStatus])
  @@index([whatsappMessageId])
  @@index([whatsappStatus])
}

enum NotificationScopeType {
  USER
  ADMIN
  SYSTEM
}

enum NotificationRecipientType {
  USER
  ADMIN
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
  DISMISSED
}

enum NotificationFrequency {
  INSTANT
  DIGEST
  MUTE
}

model NotificationEvent {
  id         String                @id @default(cuid())
  scopeType  NotificationScopeType
  scopeId    String
  eventType  String
  title      String
  message    String                @db.Text
  severity   NotificationSeverity  @default(INFO)
  entityType String?
  entityId   String?
  actorType  String?
  actorId    String?
  payload    Json?
  dedupeKey  String?

  notifications Notification[]

  createdAt  DateTime @default(now())

  @@index([scopeType, scopeId, createdAt])
  @@index([eventType, createdAt])
  @@index([dedupeKey])
}

model Notification {
  id            String                    @id @default(cuid())
  eventId       String
  event         NotificationEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientType NotificationRecipientType
  recipientId   String
  channel       NotificationChannel
  status        NotificationStatus        @default(PENDING)
  readAt        DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  errorMessage  String?                   @db.Text

  deliveryLogs  NotificationDeliveryLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([recipientType, recipientId, channel, createdAt])
  @@index([recipientType, recipientId, channel, readAt])
  @@index([status, channel, createdAt])
}

model NotificationPreference {
  id            String                    @id @default(cuid())
  recipientType NotificationRecipientType
  recipientId   String
  eventType     String
  channel       NotificationChannel
  enabled       Boolean                   @default(true)
  frequency     NotificationFrequency     @default(INSTANT)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([recipientType, recipientId, eventType, channel])
  @@index([recipientType, recipientId])
}

model NotificationDeliveryLog {
  id                String             @id @default(cuid())
  notificationId    String
  notification      Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  attempt           Int                @default(1)
  provider          String
  providerMessageId String?
  status            NotificationStatus
  responsePayload   Json?
  errorMessage      String?            @db.Text

  createdAt         DateTime @default(now())

  @@index([notificationId, createdAt])
}

enum WhatsappConnectionQualityRating {
  UNKNOWN
  GREEN
  YELLOW
  RED
}

enum WhatsappCallDirection {
  INBOUND
  OUTBOUND
}

enum WhatsappCallStatus {
  RINGING
  CONNECTING
  ACTIVE
  COMPLETED
  REJECTED
  MISSED
  FAILED
  CANCELLED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  THREADS
  LINKEDIN
  X
  WHATSAPP_STATUS
}

enum SocialChannelStatus {
  CONNECTED
  DISCONNECTED
  NEEDS_REAUTH
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
}

enum SocialPublishJobStatus {
  PENDING
  QUEUED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELED
}

enum SocialVariantStatus {
  DRAFT
  APPROVED
  NEEDS_EDITS
}

enum WhatsappTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsappTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  DISABLED
}

enum WhatsappCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  COMPLETED
  FAILED
}

enum WhatsappRecipientStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  BLOCKED
  UNSUBSCRIBED
  SKIPPED
}

model WhatsappConnection {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId                String?
  org                  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  phoneNumberId        String   @unique
  phoneDisplayNumber   String?
  accessTokenEncrypted String   @db.Text
  wabaId               String

  currentQualityRating WhatsappConnectionQualityRating @default(UNKNOWN)
  dailyLimitEstimate   Int?
  verified             Boolean  @default(false)

  templates            WhatsappTemplate[]
  campaigns            WhatsappCampaign[]
  sendEvents           WhatsappSendEvent[]
  callSessions         WhatsappCallSession[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([orgId])
  @@index([wabaId])
}

model WhatsappCallSession {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId          String?
  org            Organization?         @relation(fields: [orgId], references: [id], onDelete: SetNull)

  connectionId   String
  connection     WhatsappConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  direction      WhatsappCallDirection
  status         WhatsappCallStatus    @default(RINGING)
  waCallId       String?               @unique
  fromPhone      String
  toPhone        String
  agentLabel     String?
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSeconds Int?
  errorCode      String?
  errorMessage   String?               @db.Text
  rawPayload     Json?

  events         WhatsappCallEvent[]

  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([connectionId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model WhatsappCallEvent {
  id           String              @id @default(cuid())
  sessionId    String
  session      WhatsappCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType    String
  status       WhatsappCallStatus?
  payload      Json?
  createdAt    DateTime            @default(now())

  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
}

model SocialChannelConnection {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization?       @relation(fields: [orgId], references: [id], onDelete: SetNull)

  platform          SocialPlatform
  status            SocialChannelStatus @default(CONNECTED)
  displayName       String
  handle            String?
  externalAccountId String?

  accessToken       String?             @db.Text
  refreshToken      String?             @db.Text
  metadata          Json?
  lastSyncedAt      DateTime?

  posts             SocialPost[]
  publishJobs       SocialPublishJob[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([orgId, platform, externalAccountId])
  @@index([userId, platform])
  @@index([userId, status])
  @@index([orgId, platform])
  @@index([orgId, status])
}

model SocialPost {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization?      @relation(fields: [orgId], references: [id], onDelete: SetNull)

  primaryChannelId  String?
  primaryChannel    SocialChannelConnection? @relation(fields: [primaryChannelId], references: [id], onDelete: SetNull)

  title             String?
  prompt            String?            @db.Text
  content           String             @db.Text
  channels          SocialPlatform[]
  status            SocialPostStatus   @default(DRAFT)
  scheduledFor      DateTime?
  publishedAt       DateTime?
  metadata          Json?

  variants          SocialPostVariant[]
  publishJobs       SocialPublishJob[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, status])
  @@index([orgId, status])
  @@index([scheduledFor])
  @@index([primaryChannelId])
}

model SocialPostVariant {
  id                String              @id @default(cuid())
  postId            String
  post              SocialPost          @relation(fields: [postId], references: [id], onDelete: Cascade)

  platform          SocialPlatform
  content           String              @db.Text
  status            SocialVariantStatus @default(DRAFT)
  aiGenerated       Boolean             @default(false)
  metadata          Json?

  publishJobs       SocialPublishJob[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([postId, platform])
  @@index([platform, status])
}

model SocialPublishJob {
  id                String                 @id @default(cuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization?          @relation(fields: [orgId], references: [id], onDelete: SetNull)

  postId            String
  post              SocialPost             @relation(fields: [postId], references: [id], onDelete: Cascade)

  variantId         String?
  variant           SocialPostVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)

  channelConnectionId String?
  channelConnection SocialChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)

  platform          SocialPlatform
  status            SocialPublishJobStatus @default(PENDING)
  scheduledFor      DateTime?
  publishedAt       DateTime?
  externalPostId    String?
  errorMessage      String?                @db.Text
  metadata          Json?

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId, status])
  @@index([orgId, status])
  @@index([postId, platform])
  @@index([variantId])
  @@index([channelConnectionId])
  @@index([scheduledFor])
}

model WhatsappContact {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  phone             String
  fullName          String?
  tags              String[]
  location          String?
  listLabel         String   @default("default")
  metadata          Json?

  optIn             Boolean  @default(false)
  optInSource       String?
  optInDate         DateTime?

  lastMarketingSent DateTime?
  excluded          Boolean  @default(false)
  notes             String?  @db.Text

  listMemberships   WhatsappContactListMembership[]
  recipients        WhatsappCampaignRecipient[]
  sendEvents        WhatsappSendEvent[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([orgId, phone])
  @@index([userId, optIn, excluded])
  @@index([userId, listLabel])
  @@index([orgId, listLabel])
  @@index([lastMarketingSent])
}

model WhatsappContactListMembership {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  contactId         String
  contact           WhatsappContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  listLabel         String   @default("default")
  fullName          String?
  tags              String[]
  location          String?
  metadata          Json?

  optIn             Boolean  @default(false)
  optInSource       String?
  optInDate         DateTime?
  excluded          Boolean  @default(false)
  notes             String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([orgId, contactId, listLabel])
  @@index([userId, listLabel])
  @@index([orgId, listLabel])
  @@index([contactId])
}

model WhatsappTemplate {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId          String?
  org            Organization?            @relation(fields: [orgId], references: [id], onDelete: SetNull)

  connectionId   String?
  connection     WhatsappConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  templateName   String
  language       String
  category       WhatsappTemplateCategory @default(MARKETING)
  header         String?                  @db.Text
  body           String?                  @db.Text
  footer         String?                  @db.Text
  buttons        Json?
  variablesCount Int                      @default(0)
  status         WhatsappTemplateStatus   @default(PENDING)
  lastSynced     DateTime?

  campaigns      WhatsappCampaign[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orgId, templateName, language])
  @@index([userId, status, category])
  @@index([orgId, status])
}

model WhatsappCampaign {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId             String?
  org               Organization?         @relation(fields: [orgId], references: [id], onDelete: SetNull)

  connectionId      String
  connection        WhatsappConnection    @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  templateId        String?
  template          WhatsappTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name              String
  description       String?               @db.Text
  templateName      String
  templateLanguage  String
  variableMappings  Json?
  listLabel         String?
  defaultBatchSize  Int?

  status            WhatsappCampaignStatus @default(DRAFT)
  scheduledAt       DateTime?
  launchedAt        DateTime?
  completedAt       DateTime?

  totalRecipients   Int                    @default(0)
  sentCount         Int                    @default(0)
  deliveredCount    Int                    @default(0)
  readCount         Int                    @default(0)
  failedCount       Int                    @default(0)
  blockedCount      Int                    @default(0)
  unsubscribedCount Int                    @default(0)

  recipients        WhatsappCampaignRecipient[]
  sendEvents        WhatsappSendEvent[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, status])
  @@index([orgId, status])
  @@index([userId, listLabel])
  @@index([connectionId])
  @@index([templateId])
  @@index([scheduledAt])
}

model WhatsappCampaignRecipient {
  id             String                 @id @default(cuid())
  campaignId     String
  campaign       WhatsappCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId      String
  contact        WhatsappContact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  snapshotPhone      String?
  snapshotFullName   String?
  snapshotLocation   String?
  snapshotListLabel  String?
  snapshotMetadata   Json?

  status         WhatsappRecipientStatus @default(PENDING)
  waMessageId    String?

  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  errorCode      String?
  errorMessage   String?                @db.Text

  sendEvents     WhatsappSendEvent[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([waMessageId])
}

model WhatsappSendEvent {
  id                   String                    @id @default(cuid())
  userId               String
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId                String?
  org                  Organization?             @relation(fields: [orgId], references: [id], onDelete: SetNull)

  connectionId         String
  connection           WhatsappConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  campaignId           String?
  campaign             WhatsappCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  recipientId          String?
  recipient            WhatsappCampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  contactId            String?
  contact              WhatsappContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)

  phone                String
  templateName         String
  status               WhatsappRecipientStatus
  whatsappMessageId    String?
  whatsappConversationId      String?
  whatsappConversationOrigin  String?
  whatsappConversationExpires DateTime?
  whatsappPricingBillable     Boolean?
  whatsappPricingCategory     String?
  whatsappPricingModel        String?
  whatsappPricingType         String?

  requestPayload       Json?
  responsePayload      Json?
  errorCode            String?
  errorMessage         String?                   @db.Text

  createdAt            DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([campaignId])
  @@index([recipientId])
  @@index([contactId])
  @@index([status])
}
