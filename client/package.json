{
  "name": "kasitek-monorepo",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter client dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:call-bridge": "pnpm --filter call-bridge dev",
    "dev:call-bridge:worker:meta-stub": "pnpm --filter call-bridge worker:meta-stub",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "dev:worker:whatsapp": "cd ../server/kasitek-core && KASITEK_PROCESS=whatsapp-marketing-worker cargo run",
    "build": "pnpm db:generate && pnpm --filter './apps/*' build",
    "build:client": "pnpm db:generate && pnpm --filter client build",
    "build:admin": "pnpm db:generate && pnpm --filter admin build",
    "db:generate": "pnpm --filter @kasitek/database generate",
    "db:push": "pnpm --filter @kasitek/database db:push",
    "db:migrate": "pnpm --filter @kasitek/database db:migrate",
    "db:studio": "pnpm --filter @kasitek/database studio",
    "db:seed": "pnpm --filter @kasitek/database seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ]
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
