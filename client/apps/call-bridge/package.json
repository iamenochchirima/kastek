{
  "name": "call-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs && node --check src/workers/meta-cloud-api-stub.mjs && node --check src/providers/meta-cloud-api-livekit-relay.mjs",
    "worker:meta-stub": "node src/workers/meta-cloud-api-stub.mjs",
    "worker:meta-relay": "META_CLOUD_API_WORKER_MODE=relay node src/workers/meta-cloud-api-stub.mjs",
    "provider:meta-livekit-relay": "node src/providers/meta-cloud-api-livekit-relay.mjs"
  },
  "dependencies": {
    "@livekit/rtc-node": "^0.13.25"
  }
}
