{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/conversation_message/v1.schema.json",
  "title": "Agent conversation message analytics attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "conversation_id",
    "installation_id",
    "agent_definition_id",
    "agent_version_id",
    "agent_audience",
    "conversation_kind",
    "channel",
    "action",
    "direction",
    "responder_type",
    "message_type",
    "delivery_status",
    "run_id",
    "response_time_ms",
    "occurred_at"
  ],
  "properties": {
    "message_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": "string", "minLength": 1 },
    "agent_audience": { "type": "string", "enum": ["personal", "customer_service"] },
    "conversation_kind": { "type": "string", "enum": ["personal", "customer", "test", "external"] },
    "channel": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["created", "delivery_updated"] },
    "direction": { "type": "string", "enum": ["inbound", "outbound", "system"] },
    "responder_type": { "type": "string", "enum": ["customer", "human", "agent", "system"] },
    "message_type": { "type": "string", "minLength": 1 },
    "delivery_status": { "type": ["string", "null"] },
    "run_id": { "type": ["string", "null"] },
    "response_time_ms": { "type": ["integer", "null"], "minimum": 0 },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.conversation.message@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["content", "body", "message_body", "preview", "provider_message_id", "external_conversation_id", "customer_id", "phone_number", "email", "credential", "token"]
  }
}
