{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/schedule_lifecycle/v1.schema.json",
  "title": "Agent schedule lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schedule_id",
    "agent_definition_id",
    "agent_version_id",
    "installation_id",
    "action",
    "status",
    "previous_status",
    "timezone",
    "next_run_at",
    "actor_type",
    "occurred_at"
  ],
  "properties": {
    "schedule_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": "string", "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["created", "activated", "paused", "disabled"] },
    "status": { "type": "string", "enum": ["active", "paused", "disabled"] },
    "previous_status": { "type": ["string", "null"], "enum": ["active", "paused", "disabled", null] },
    "timezone": { "type": "string", "minLength": 1 },
    "next_run_at": { "type": ["string", "null"], "format": "date-time" },
    "actor_type": { "type": "string", "enum": ["human", "system"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.schedule.lifecycle@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["input", "expression", "prompt", "response", "content", "credential", "token", "phone_number", "email"]
  }
}
