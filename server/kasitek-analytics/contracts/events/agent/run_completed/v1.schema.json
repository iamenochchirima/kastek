{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/run_completed/v1.schema.json",
  "title": "Agent run completed attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "installation_id", "agent_definition_id", "status", "occurred_at"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": "string", "minLength": 1 },
    "status": { "const": "completed" },
    "outcome": { "type": "string", "enum": ["success", "partial", "no_effect"] },
    "trigger_type": { "type": "string", "enum": ["message", "schedule", "webhook", "manual"] },
    "execution_mode": { "type": "string", "enum": ["system_hosted", "kasitek_hosted", "external_connected"] },
    "creation_profile": { "type": "string", "enum": ["general", "custom", "system"] },
    "agent_audience": { "type": "string", "enum": ["personal", "customer_service"] },
    "deployment_surface": { "type": "string", "enum": ["conversation", "external_operation", "direct"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 }
  },
  "x-kasitek": {
    "identity": "agent.run.completed@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["prompt", "response", "phone_number", "email", "credential", "token"]
  }
}
