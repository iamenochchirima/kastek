{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/envelope.schema.json",
  "title": "KasiTek analytics CloudEvents-compatible envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "data"
  ],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri" },
    "source_service": { "type": "string", "enum": ["core", "agent-platform", "tenant-platform"] },
    "source_domain": { "type": "string", "minLength": 1 },
    "record_category": { "enum": ["event", "observation", "scope_definition", "manifest"] },
    "scope_kind": { "enum": ["core_organization", "tenant_workspace", "tenant_client"] },
    "scope_external_id": { "type": "string", "minLength": 1 },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "data": { "type": "object" }
  }
}
