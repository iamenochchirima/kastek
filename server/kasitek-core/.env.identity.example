# Additional settings for native Labs Keycloak. Copy into the ignored Core .env.
FRONTEND_URL=http://localhost:3000
OIDC_ISSUER_URL=http://localhost:8080/realms/kasitek
OIDC_CLIENT_ID=growth
OIDC_CLIENT_SECRET=<GROWTH_OIDC_CLIENT_SECRET from Labs identity .env>
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_ADMIN_CLIENT_ID=growth-session-admin
OIDC_ADMIN_CLIENT_SECRET=<GROWTH_SESSION_ADMIN_SECRET from Labs identity .env>
OIDC_REVOCATION_CHECK_SECONDS=300
LOCAL_MAILPIT_URL=http://localhost:8025
