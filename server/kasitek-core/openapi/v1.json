{
  "openapi": "3.1.0",
  "info": {
    "title": "KasiTek Public API",
    "version": "1.0.0",
    "description": "Core-owned public v1 contracts for authenticated product sessions and installation REST clients. Capability discovery is filtered for the authenticated principal. Every response includes x-api-version and x-correlation-id; authenticated requests also expose x-ratelimit-limit, x-ratelimit-remaining, and x-ratelimit-reset (seconds). Error responses include a stable code alongside the human-readable error."
  },
  "servers": [{ "url": "/v1" }],
  "security": [{ "bearerInstallation": [] }, { "productSession": [] }],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getPublicOpenApi",
        "security": [],
        "responses": {
          "200": { "description": "Core-owned OpenAPI 3.1 document", "content": { "application/json": { "schema": { "type": "object", "required": ["openapi", "info", "paths"], "additionalProperties": true } } } }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getPublicHealth",
        "security": [],
        "responses": { "200": { "description": "Service health", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } }
      }
    },
    "/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Principal-filtered public actions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CapabilityPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getPublicMetrics",
        "responses": {
          "200": { "description": "Principal-scoped one-hour request metrics", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicMetrics" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/content/posts": {
      "get": {
        "operationId": "listContentPosts",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Organization-scoped content posts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "post": {
        "operationId": "createContentDraft",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContentDraftInput" } } } },
        "responses": {
          "201": { "description": "Draft created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/content/posts/{id}": {
      "get": {
        "operationId": "getContentPost",
        "parameters": [{ "$ref": "#/components/parameters/PostId" }],
        "responses": {
          "200": { "description": "Content post", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "patch": {
        "operationId": "updateContentDraft",
        "parameters": [{ "$ref": "#/components/parameters/PostId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContentDraftInput" } } } },
        "responses": {
          "200": { "description": "Draft updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PostResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/content/posts/{id}/activity": {
      "get": {
        "operationId": "getContentPostActivity",
        "parameters": [{ "$ref": "#/components/parameters/PostId" }],
        "responses": {
          "200": { "description": "Secret-safe durable content activity", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/contacts": {
      "get": {
        "operationId": "listContacts",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Redacted organization-scoped contacts", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/inbox/conversations": {
      "get": {
        "operationId": "listInboxConversations",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Redacted organization-scoped conversations", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/inbox/conversations/{id}/messages": {
      "get": {
        "operationId": "listInboxMessages",
        "parameters": [
          { "$ref": "#/components/parameters/ConversationId" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Redacted conversation messages", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/bookings": {
      "get": {
        "operationId": "listBookings",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Organization-scoped bookings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/campaigns": {
      "get": {
        "operationId": "listCampaigns",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Redacted organization-scoped campaigns", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/campaigns/{id}": {
      "get": {
        "operationId": "getCampaignSummary",
        "parameters": [{ "$ref": "#/components/parameters/CampaignId" }],
        "responses": {
          "200": { "description": "Redacted campaign summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/templates": {
      "get": {
        "operationId": "listTemplates",
        "parameters": [
          { "$ref": "#/components/parameters/TemplateStatus" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Redacted organization-scoped templates", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResourceList" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/webhooks/subscriptions": {
      "get": {
        "operationId": "listWebhookSubscriptions",
        "parameters": [
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Organization-scoped webhook subscriptions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "operationId": "createWebhookSubscription",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionInput" } } } },
        "responses": {
          "201": { "description": "Subscription created; the signing secret is returned once", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionCreated" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/webhooks/subscriptions/{id}": {
      "patch": {
        "operationId": "updateWebhookSubscription",
        "parameters": [{ "$ref": "#/components/parameters/WebhookSubscriptionId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionUpdate" } } } },
        "responses": {
          "200": { "description": "Subscription updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookSubscriptionResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "delete": {
        "operationId": "disableWebhookSubscription",
        "parameters": [{ "$ref": "#/components/parameters/WebhookSubscriptionId" }],
        "responses": {
          "200": { "description": "Subscription disabled", "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "const": "disabled" } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/webhooks/subscriptions/{id}/deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries",
        "parameters": [
          { "$ref": "#/components/parameters/WebhookSubscriptionId" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Version" }
        ],
        "responses": {
          "200": { "description": "Durable delivery diagnostics", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebhookDeliveryPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerInstallation": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT", "description": "Short-lived audience-bound installation token for kasitek-public-api." },
      "productSession": { "type": "apiKey", "in": "cookie", "name": "kasitek_session", "description": "Authenticated KasiTek product session cookie." }
    },
    "parameters": {
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } },
      "Cursor": { "name": "cursor", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
      "Version": { "name": "version", "in": "query", "schema": { "type": "string", "enum": ["v1"] } },
      "PostId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "ConversationId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "CampaignId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "TemplateStatus": { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED", "DISABLED"] } },
      "WebhookSubscriptionId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "description": "Stable client-generated key used to safely retry a mutating public operation.", "schema": { "type": "string", "minLength": 1, "maxLength": 240 } }
    },
    "responses": {
      "BadRequest": { "description": "Invalid request", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Authentication required or invalid", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Action is not available to this principal", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Resource not found", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Request conflicts with current resource state", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimited": { "description": "Public API rate limit exceeded", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" }, "RetryAfter": { "$ref": "#/components/headers/RetryAfter" }, "RateLimitLimit": { "$ref": "#/components/headers/RateLimitLimit" }, "RateLimitRemaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "RateLimitReset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Internal": { "description": "Unexpected server failure", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ServiceUnavailable": { "description": "Route is disabled by deployment policy or dependencies are unavailable", "headers": { "ApiVersion": { "$ref": "#/components/headers/ApiVersion" }, "CorrelationId": { "$ref": "#/components/headers/CorrelationId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Health": { "type": "object", "required": ["status", "service", "apiVersion"], "properties": { "status": { "type": "string" }, "service": { "type": "string" }, "apiVersion": { "type": "string" }, "actionCatalogSize": { "type": "integer" } }, "additionalProperties": true },
      "PublicMetrics": { "type": "object", "required": ["schema", "windowSeconds", "principal", "requests"], "properties": { "schema": { "const": "kasitek-public-metrics-v1" }, "windowSeconds": { "const": 3600 }, "principal": { "type": "object", "required": ["kind"], "properties": { "kind": { "type": "string" } }, "additionalProperties": false }, "requests": { "type": "object", "required": ["total", "successful", "clientErrors", "serverErrors", "inFlight"], "properties": { "total": { "type": "integer", "minimum": 0 }, "successful": { "type": "integer", "minimum": 0 }, "clientErrors": { "type": "integer", "minimum": 0 }, "serverErrors": { "type": "integer", "minimum": 0 }, "inFlight": { "type": "integer", "minimum": 0 } }, "additionalProperties": false } }, "additionalProperties": false },
      "Error": { "type": "object", "required": ["error", "code"], "properties": { "error": { "type": "string" }, "code": { "type": "string", "enum": ["bad_request", "unauthorized", "unsupported_principal", "forbidden", "not_found", "conflict", "rate_limited", "service_unavailable", "bad_gateway", "gateway_timeout", "internal_error"] } }, "additionalProperties": true },
      "CapabilityPage": { "type": "object", "required": ["version", "principal", "principalPolicy", "transportPolicy", "actions", "pagination"], "properties": { "version": { "const": "v1" }, "principal": { "type": "object", "additionalProperties": true }, "principalPolicy": { "$ref": "#/components/schemas/PublicPrincipalPolicy" }, "transportPolicy": { "$ref": "#/components/schemas/PublicTransportPolicy" }, "actions": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "pagination": { "type": "object", "additionalProperties": true } }, "additionalProperties": false },
      "PublicPrincipalPolicy": { "type": "object", "required": ["supported", "notYetSupported", "agentInstallationRequirements"], "properties": { "supported": { "type": "array", "items": { "type": "string", "enum": ["direct_user", "agent_installation"] } }, "notYetSupported": { "type": "array", "items": { "type": "string", "enum": ["workspace_api_key", "service_account", "oauth_user", "oauth_application"] } }, "agentInstallationRequirements": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
      "PublicTransportPolicy": { "type": "object", "required": ["featureFlag", "deprecationRoutes", "deprecationHeaders"], "properties": { "featureFlag": { "const": "PUBLIC_API_DISABLED_ROUTES" }, "deprecationRoutes": { "const": "PUBLIC_API_DEPRECATED_ROUTES" }, "deprecationHeaders": { "type": "array", "items": { "type": "string", "enum": ["Deprecation", "Sunset", "Link"] } } }, "additionalProperties": false },
      "PostList": { "type": "object", "required": ["posts", "pagination"], "properties": { "posts": { "type": "array", "items": { "type": "object", "additionalProperties": true } }, "pagination": { "$ref": "#/components/schemas/Pagination" } }, "additionalProperties": false },
      "PostResponse": { "type": "object", "required": ["post"], "properties": { "post": { "type": "object", "additionalProperties": true } }, "additionalProperties": false },
      "ResourceList": { "type": "object", "description": "Resource-specific list envelope. Sensitive provider and customer fields are redacted by the core boundary.", "additionalProperties": true },
      "Pagination": { "type": "object", "required": ["limit", "cursor", "nextCursor", "total", "version"], "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "cursor": { "type": "integer", "minimum": 0 }, "nextCursor": { "type": ["integer", "null"], "minimum": 0 }, "total": { "type": "integer", "minimum": 0 }, "version": { "const": "v1" } }, "additionalProperties": false },
      "ResourceResponse": { "type": "object", "description": "Resource-specific response envelope with sensitive fields redacted by the core boundary.", "additionalProperties": true },
      "ContentDraftInput": { "type": "object", "description": "Core SocialPostUpsertRequest contract. The core validates the complete domain shape and organization ownership. Draft creation requires the Idempotency-Key header.", "additionalProperties": true },
      "WebhookSubscription": { "type": "object", "required": ["id", "url", "eventTypes", "status", "failureCount", "createdAt", "updatedAt"], "properties": { "id": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "eventTypes": { "type": "array", "items": { "type": "string", "enum": ["public_api.request.completed", "content.post.created", "content.post.updated"] } }, "status": { "type": "string", "enum": ["ACTIVE", "DISABLED"] }, "failureCount": { "type": "integer", "minimum": 0 }, "lastDeliveredAt": { "type": ["string", "null"], "format": "date-time" }, "lastFailureAt": { "type": ["string", "null"], "format": "date-time" }, "disabledAt": { "type": ["string", "null"], "format": "date-time" }, "disabledReason": { "type": ["string", "null"] }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
      "WebhookSubscriptionInput": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" }, "eventTypes": { "type": "array", "maxItems": 8, "items": { "type": "string", "enum": ["public_api.request.completed", "content.post.created", "content.post.updated"] } }, "secret": { "type": "string", "minLength": 32, "maxLength": 512 } }, "additionalProperties": false },
      "WebhookSubscriptionUpdate": { "type": "object", "properties": { "url": { "type": "string", "format": "uri" }, "eventTypes": { "type": "array", "maxItems": 8, "items": { "type": "string", "enum": ["public_api.request.completed", "content.post.created", "content.post.updated"] } }, "enabled": { "type": "boolean" } }, "additionalProperties": false },
      "WebhookSubscriptionResponse": { "type": "object", "required": ["subscription"], "properties": { "subscription": { "$ref": "#/components/schemas/WebhookSubscription" } }, "additionalProperties": false },
      "WebhookSubscriptionCreated": { "type": "object", "required": ["subscription", "secret", "secretDelivery"], "properties": { "subscription": { "$ref": "#/components/schemas/WebhookSubscription" }, "secret": { "type": "string" }, "secretDelivery": { "type": "string", "enum": ["returned_once", "idempotency_replay"] } }, "additionalProperties": false },
