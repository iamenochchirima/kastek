{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/metrics/index.schema.json",
  "title": "KasiTek analytics metric registry index",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "files"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "registry_version": { "type": "string", "pattern": "^[0-9]{8}\\.[0-9]+$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
