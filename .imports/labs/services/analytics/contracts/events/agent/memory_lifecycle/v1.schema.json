{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/memory_lifecycle/v1.schema.json",
  "title": "Agent memory lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "agent_definition_id",
    "agent_version_id",
    "installation_id",
    "memory_kind",
    "namespace",
    "action",
    "status",
    "occurred_at"
  ],
  "properties": {
    "workspace_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": ["string", "null"], "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "memory_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "minLength": 1 },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "memory_kind": { "type": "string", "enum": ["working", "episodic", "semantic", "procedural", "knowledge"] },
    "namespace": { "type": "string", "enum": ["conversation", "end_user_private", "workspace_shared", "agent_private", "procedural", "knowledge"] },
    "action": { "type": "string", "enum": ["capture", "candidate", "review", "conflict", "checkpoint"] },
    "status": { "type": "string", "enum": ["observed", "candidate", "review_pending", "quarantined", "active", "rejected", "superseded", "expired", "deleted", "accepted", "requested", "committed", "blocked", "failed", "replayed"] },
    "transition_from": { "type": "string", "enum": ["observed", "candidate", "review_pending", "quarantined", "active", "rejected", "superseded", "expired", "deleted"] },
    "transition_to": { "type": "string", "enum": ["observed", "candidate", "review_pending", "quarantined", "active", "rejected", "superseded", "expired", "deleted"] },
    "relation_type": { "type": "string", "enum": ["supports", "contradicts", "supersedes", "derived_from", "about"] },
    "sensitivity": { "type": "string", "enum": ["normal", "sensitive", "restricted"] },
    "source_event_count": { "type": "integer", "minimum": 0 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "conflict_count": { "type": "integer", "minimum": 0 },
    "retry_count": { "type": "integer", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,119}$" },
    "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,119}$" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.memory.lifecycle@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["body", "content", "canonical_text", "evidence", "prompt", "query", "response", "error_message", "credential", "token", "phone_number", "email"]
  }
}
