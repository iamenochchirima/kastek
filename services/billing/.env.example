# Central billing service
BILLING_DATABASE_URL=postgresql://localhost:5432/kasitek_billing
BILLING_HOST=127.0.0.1
BILLING_PORT=4500
BILLING_PUBLIC_URL=http://localhost:4500
BILLING_ENVIRONMENT=development

# Product-to-billing request signing. At least 32 bytes.
BILLING_INTERNAL_SECRET=
# Entitlement snapshot signing. At least 32 bytes.
BILLING_SNAPSHOT_SECRET=
# Existing admin service authority. Audience is always "billing".
KASITEK_ADMIN_SERVICE_SECRET=

# Paystack. Live mode fails closed when the live key is missing.
PAYSTACK_MODE=test
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co

BILLING_DEFAULT_CURRENCY=ZAR
BILLING_TAX_RATE_BPS=1500
BILLING_INVOICE_PREFIX=KS
BILLING_RECONCILIATION_INTERVAL_SECONDS=300
BILLING_RECONCILIATION_BATCH_SIZE=100
# Browser origins allowed as checkout return destinations.
BILLING_RETURN_ORIGINS=http://localhost:3000,http://localhost:4100,http://localhost:3010
# Optional free plan per product, for example {"growth":"growth-free","agents":"agents-free","agency":"agency-free"}.
BILLING_FREE_PLANS_JSON={"growth":"growth-free","agents":"agents-free","agency":"agency-free"}
# Optional self-serve trial plan per product and duration in days.
BILLING_TRIAL_PLANS_JSON={"growth":"growth-mid"}
BILLING_TRIAL_DAYS=14
