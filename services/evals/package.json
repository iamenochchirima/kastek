{
  "name": "@kasitek/evals-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/api-main.js",
    "client": "tsx src/cli.ts",
    "client:built": "node dist/cli.js",
    "migrate": "node dist/migrate-main.js",
    "dev": "tsx watch src/api-main.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
