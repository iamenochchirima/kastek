{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/manifests/source.manifest/v1.schema.json",
  "title": "KasiTek source capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_key",
    "manifest_version",
    "supported_contracts",
    "supported_observation_contracts",
    "supported_metrics",
    "supported_dimensions",
    "expected_refresh_seconds",
    "manifest_state",
    "generated_at"
  ],
  "properties": {
    "manifest_key": { "type": "string", "minLength": 1, "maxLength": 512 },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "provider": { "type": ["string", "null"], "maxLength": 128 },
    "connection_ref": { "type": ["string", "null"], "maxLength": 512 },
    "supported_contracts": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$", "maxLength": 256 }
    },
    "supported_observation_contracts": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$", "maxLength": 256 }
    },
    "supported_metrics": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 256 }
    },
    "supported_dimensions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 256 }
    },
    "expected_refresh_seconds": { "type": "integer", "minimum": 1 },
    "reliable_coverage_start": { "type": ["string", "null"], "format": "date-time" },
    "highest_authoritative_source_sequence": { "type": ["integer", "null"], "minimum": 0 },
    "approved_checkpoint_count": { "type": ["integer", "null"], "minimum": 0 },
    "approved_checkpoint_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "last_successful_collection_at": { "type": ["string", "null"], "format": "date-time" },
    "last_attempted_collection_at": { "type": ["string", "null"], "format": "date-time" },
    "safe_failure_code": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_.-]+$" },
    "next_expected_at": { "type": ["string", "null"], "format": "date-time" },
    "manifest_state": {
      "enum": ["active", "disabled", "unsupported", "awaiting_instrumentation"]
    },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
