{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/installation_lifecycle/v1.schema.json",
  "title": "Agent installation lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installation_id",
    "agent_definition_id",
    "agent_version_id",
    "execution_mode",
    "creation_profile",
    "agent_audience",
    "scope_type",
    "action",
    "status",
    "previous_status",
    "actor_type",
    "occurred_at"
  ],
  "properties": {
    "installation_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": "string", "minLength": 1 },
    "execution_mode": { "type": "string", "enum": ["system_hosted", "kasitek_hosted", "external_connected"] },
    "creation_profile": { "type": "string", "enum": ["general", "custom", "system"] },
    "agent_audience": { "type": "string", "enum": ["personal", "customer_service"] },
    "scope_type": { "type": "string", "enum": ["organization", "user", "business"] },
    "action": { "type": "string", "enum": ["created", "activated", "paused", "disabled"] },
    "status": { "type": "string", "enum": ["active", "paused", "disabled"] },
    "previous_status": { "type": ["string", "null"], "enum": ["active", "paused", "disabled", null] },
    "actor_type": { "type": "string", "enum": ["human", "system"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.installation.lifecycle@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["settings", "input", "prompt", "response", "content", "credential", "token", "phone_number", "email"]
  }
}
