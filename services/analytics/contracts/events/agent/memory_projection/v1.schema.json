{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/memory_projection/v1.schema.json",
  "title": "Agent memory projection attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "agent_definition_id",
    "agent_version_id",
    "installation_id",
    "projection_id",
    "revision_id",
    "projection_kind",
    "operation",
    "status",
    "attempt_count",
    "occurred_at"
  ],
  "properties": {
    "workspace_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": ["string", "null"], "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "projection_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "minLength": 1 },
    "projection_kind": { "type": "string", "enum": ["fts", "vector", "temporal", "provider"] },
    "operation": { "type": "string", "enum": ["upsert", "delete", "revalidate"] },
    "status": { "type": "string", "enum": ["accepted", "indexing", "indexed", "visible", "failed", "blocked", "deleted"] },
    "provider_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "provider_state": { "type": "string", "enum": ["accepted", "indexed", "visible", "failed", "deleted"] },
    "projection_version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "max_attempts": { "type": "integer", "minimum": 1 },
    "retryable": { "type": "boolean" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,119}$" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.memory.projection@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["body", "content", "canonical_text", "embedding", "provider_payload", "prompt", "query", "response", "error_message", "credential", "token", "phone_number", "email"]
  }
}
