{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/memory_retrieval/v1.schema.json",
  "title": "Agent memory retrieval attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "agent_definition_id",
    "agent_version_id",
    "installation_id",
    "retrieval_id",
    "decision",
    "status",
    "freshness",
    "memory_kinds",
    "reason_code",
    "planner_version",
    "candidate_count",
    "evidence_count",
    "selected_count",
    "measured_tokens",
    "max_tokens",
    "latency_ms",
    "occurred_at"
  ],
  "properties": {
    "workspace_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": ["string", "null"], "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "retrieval_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "source_boundary_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "query_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "query_length": { "type": "integer", "minimum": 0 },
    "decision": { "type": "string", "enum": ["not_requested", "requested", "required"] },
    "status": { "type": "string", "enum": ["completed", "blocked", "failed"] },
    "freshness": { "type": "string", "enum": ["current", "historical", "any"] },
    "memory_kinds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "enum": ["working", "episodic", "semantic", "procedural", "knowledge"] } },
    "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,119}$" },
    "planner_version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "selected_count": { "type": "integer", "minimum": 0 },
    "measured_tokens": { "type": "integer", "minimum": 0 },
    "max_tokens": { "type": "integer", "minimum": 1 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "gate_source": { "type": "string", "enum": ["none", "heuristic", "model"] },
    "gate_model": { "type": "string", "minLength": 1, "maxLength": 160 },
    "gate_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "gate_latency_ms": { "type": "integer", "minimum": 0 },
    "scope_rejection": { "type": "boolean" },
    "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,119}$" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.memory.retrieval@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["body", "content", "canonical_text", "evidence", "prompt", "query", "response", "selected_revision_text", "error_message", "credential", "token", "phone_number", "email"]
  }
}
