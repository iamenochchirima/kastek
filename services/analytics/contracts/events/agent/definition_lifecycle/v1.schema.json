{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/definition_lifecycle/v1.schema.json",
  "title": "Agent definition lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_definition_id",
    "owner_type",
    "creation_profile",
    "agent_audience",
    "action",
    "status",
    "changed_fields",
    "actor_type",
    "occurred_at"
  ],
  "properties": {
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "owner_type": { "type": "string", "enum": ["organization", "system"] },
    "creation_profile": { "type": "string", "enum": ["general", "custom", "system"] },
    "agent_audience": { "type": "string", "enum": ["personal", "customer_service"] },
    "action": { "type": "string", "enum": ["created", "updated", "archived", "restored", "deleted"] },
    "status": { "type": "string", "enum": ["active", "paused", "archived", "deleted"] },
    "changed_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["name", "slug", "description", "status"] }
    },
    "actor_type": { "type": "string", "enum": ["human", "system"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.definition.lifecycle@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["name", "slug", "description", "instructions", "configuration", "policy", "checksum", "credential", "token", "phone_number", "email"]
  }
}
