{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/tool_invocation_lifecycle/v1.schema.json",
  "title": "Agent tool invocation lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_invocation_id",
    "run_id",
    "agent_definition_id",
    "agent_version_id",
    "installation_id",
    "provider_tool_call_id",
    "tool_name",
    "tool_version",
    "risk_class",
    "action",
    "status",
    "sequence_number",
    "requires_approval",
    "occurred_at"
  ],
  "properties": {
    "tool_invocation_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": "string", "minLength": 1 },
    "installation_id": { "type": "string", "minLength": 1 },
    "provider_tool_call_id": { "type": "string", "minLength": 1 },
    "tool_name": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "minLength": 1 },
    "risk_class": { "type": "string", "enum": ["read", "draft", "controlled-write", "external-effect", "privileged"] },
    "action": { "type": "string", "enum": ["proposed", "completed", "failed"] },
    "status": { "type": "string", "enum": ["proposed", "awaiting_approval", "approved", "rejected", "executing", "completed", "failed"] },
    "sequence_number": { "type": "integer", "minimum": 1 },
    "requires_approval": { "type": "boolean" },
    "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
    "effect_id": { "type": ["string", "null"], "minLength": 1 },
    "failure_class": { "type": ["string", "null"], "enum": ["validation", "provider", "tool", "timeout", "policy", "unknown", null] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.tool_invocation.lifecycle@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["arguments", "output", "error", "error_message", "content", "prompt", "response", "credential", "token", "phone_number", "email"]
  }
}
