{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/audio_transcription_started/v1.schema.json",
  "title": "Agent audio transcription started attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "provider", "attempt", "occurred_at"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "provider": { "const": "elevenlabs" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.audio_transcription.started@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["transcript", "audio_url", "storage_key", "filename", "provider_job_id", "credential", "token"]
  }
}
