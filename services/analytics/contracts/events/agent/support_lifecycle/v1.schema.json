{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/support_lifecycle/v1.schema.json",
  "title": "Native Agents support lifecycle fact",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_definition_id", "agent_version_id", "channel_type", "action", "outcome", "occurred_at"],
  "properties": {
    "agent_definition_id": { "type": "string", "format": "uuid" },
    "agent_version_id": { "type": "string", "format": "uuid" },
    "channel_type": { "type": "string", "enum": ["website", "whatsapp", "telegram", "facebook", "instagram"] },
    "action": {
      "type": "string",
      "enum": [
        "handoff_requested",
        "acknowledgement_committed",
        "waiting_update_committed",
        "handoff_overdue",
        "staff_alert_created",
        "first_human_reply",
        "customer_notification_delivery"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "model", "fallback", "published", "created", "accepted_by_provider", "sent", "delivered", "read", "failed", "unknown", "suppressed"]
    },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 2592000000 },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.support.lifecycle@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["conversation_id", "customer_id", "message_id", "summary", "customer_message", "content", "prompt", "response", "phone_number", "email", "credential", "token"]
  }
}
