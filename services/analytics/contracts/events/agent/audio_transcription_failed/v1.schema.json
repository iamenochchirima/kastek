{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/audio_transcription_failed/v1.schema.json",
  "title": "Agent audio transcription failed attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "provider", "channel", "error_code", "retryable", "attempt", "occurred_at"],
  "properties": {
    "job_id": { "type": "string", "minLength": 1 },
    "provider": { "const": "elevenlabs" },
    "channel": { "type": "string", "enum": ["whatsapp", "telegram", "discord", "platform", "website"] },
    "error_code": { "type": "string", "pattern": "^[A-Z0-9_]{1,80}$" },
    "retryable": { "type": "boolean" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.audio_transcription.failed@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["error_message", "transcript", "audio_url", "storage_key", "filename", "provider_job_id", "credential", "token", "phone_number", "email"]
  }
}
