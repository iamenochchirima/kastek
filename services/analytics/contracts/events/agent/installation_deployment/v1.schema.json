{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/installation_deployment/v1.schema.json",
  "title": "Agent installation deployment attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installation_id",
    "agent_definition_id",
    "agent_version_id",
    "previous_agent_version_id",
    "release_mode",
    "action",
    "trigger",
    "outcome",
    "actor_type",
    "occurred_at"
  ],
  "properties": {
    "installation_id": { "type": "string", "minLength": 1 },
    "agent_definition_id": { "type": "string", "minLength": 1 },
    "agent_version_id": { "type": "string", "minLength": 1 },
    "previous_agent_version_id": { "type": ["string", "null"] },
    "release_mode": { "type": "string", "enum": ["pinned", "follow_published", "staged"] },
    "action": { "type": "string", "enum": ["deployed", "rolled_back", "failed"] },
    "trigger": { "type": "string", "enum": ["version_published", "version_rolled_back", "manual", "canary"] },
    "outcome": { "type": "string", "enum": ["success", "failure"] },
    "error_code": { "type": ["string", "null"], "maxLength": 120 },
    "actor_type": { "type": "string", "enum": ["human", "system"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.installation.deployment@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["settings", "input", "prompt", "response", "content", "credential", "token", "phone_number", "email"]
  }
}
