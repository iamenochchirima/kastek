{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/agent/model_call_failed/v1.schema.json",
  "title": "Agent model call failed attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_call_id", "run_id", "provider", "model", "funding_source", "status", "failure_class", "occurred_at"],
  "properties": {
    "model_call_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": ["string", "null"] },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "funding_source": { "type": "string", "enum": ["kasitek", "user"] },
    "failure_class": { "type": "string", "enum": ["validation", "provider", "tool", "timeout", "policy", "unknown"] },
    "status": { "const": "failed" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "agent.model_call.failed@1",
    "owner": "agent-platform",
    "privacy_class": "aggregate",
    "prohibited_fields": ["prompt", "response", "error", "error_message", "credential", "credential_reference", "token", "phone_number", "email"]
  }
}
