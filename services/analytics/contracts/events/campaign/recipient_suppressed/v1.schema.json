{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/campaign/recipient_suppressed/v1.schema.json",
  "title": "Campaign recipient suppressed attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "recipient_id", "channel", "occurred_at", "status", "suppression_class"],
  "properties": {
    "campaign_id": { "type": "string", "minLength": 1 },
    "recipient_id": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "enum": ["email", "sms", "whatsapp", "social"] },
    "provider": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "status": { "const": "suppressed" },
    "suppression_class": {
      "type": "string",
      "enum": ["manual_exclusion", "not_opted_in", "contact_excluded", "cooldown", "policy_guard"]
    }
  },
  "x-kasitek": {
    "identity": "campaign.recipient.suppressed@1",
    "owner": "core-campaigns",
    "privacy_class": "aggregate",
    "prohibited_fields": ["phone_number", "email", "message_body", "credential", "token", "raw_error"]
  }
}
