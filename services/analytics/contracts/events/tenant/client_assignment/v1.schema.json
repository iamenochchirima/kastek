{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/tenant/client_assignment/v1.schema.json",
  "title": "Tenant client assignment lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_client_id", "tenant_user_id", "action", "status", "assignment_role", "occurred_at"],
  "properties": {
    "tenant_client_id": { "type": "string", "minLength": 1 },
    "tenant_user_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["assigned", "unassigned", "role_changed"] },
    "status": { "type": "string", "enum": ["active", "revoked"] },
    "assignment_role": { "type": "string", "enum": ["owner", "admin", "member", "viewer"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "tenant.client.assignment@1",
    "owner": "tenant-platform-assignments",
    "privacy_class": "aggregate",
    "prohibited_fields": ["name", "email", "phone", "metadata", "external_ref", "credential", "token"]
  }
}
