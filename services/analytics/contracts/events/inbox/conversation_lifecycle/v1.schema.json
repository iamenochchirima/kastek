{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/inbox/conversation_lifecycle/v1.schema.json",
  "title": "Core Inbox conversation lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["conversation_id", "channel", "action", "status", "actor_type", "occurred_at"],
  "properties": {
    "conversation_id": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "enum": ["opened", "reopened", "archived", "closed", "resolved", "deleted"] },
    "status": { "type": "string", "minLength": 1 },
    "actor_type": { "type": "string", "enum": ["customer", "human", "agent", "system"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "conversation.lifecycle@1",
    "owner": "core-inbox",
    "privacy_class": "aggregate",
    "prohibited_fields": ["title", "preview", "customer_identifier", "phone_number", "email", "message_body", "credential", "token"]
  }
}
