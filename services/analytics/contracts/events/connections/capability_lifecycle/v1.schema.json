{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/connections/capability_lifecycle/v1.schema.json",
  "title": "Core connection capability lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": ["connection_id", "provider", "capability", "action", "enabled", "occurred_at"],
  "properties": {
    "connection_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "capability": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{0,127}$" },
    "action": { "type": "string", "enum": ["enabled", "disabled"] },
    "enabled": { "type": "boolean" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "connection.capability.lifecycle@1",
    "owner": "core-connections",
    "privacy_class": "aggregate",
    "prohibited_fields": ["display_name", "handle", "external_account_id", "metadata", "credential", "token", "provider_payload"]
  }
}
