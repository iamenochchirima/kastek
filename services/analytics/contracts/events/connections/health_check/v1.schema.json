{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/connections/health_check/v1.schema.json",
  "title": "Core connection health check attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection_id",
    "provider",
    "status",
    "health_status",
    "credential_status",
    "webhook_status",
    "check_result",
    "occurred_at"
  ],
  "properties": {
    "connection_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "health_status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "credential_status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "webhook_status": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "check_result": { "type": "string", "enum": ["healthy", "unhealthy", "unknown"] },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "connection.health_check@1",
    "owner": "core-connections",
    "privacy_class": "aggregate",
    "prohibited_fields": ["display_name", "handle", "external_account_id", "metadata", "last_error", "error_message", "credential", "token", "provider_payload"]
  }
}
