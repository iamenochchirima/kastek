{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/contracts/events/connections/incident_lifecycle/v1.schema.json",
  "title": "Core connection incident lifecycle attributes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection_id",
    "provider",
    "incident_key",
    "action",
    "severity",
    "reason_code",
    "occurred_at"
  ],
  "properties": {
    "connection_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,63}$" },
    "incident_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
    "action": { "type": "string", "enum": ["opened", "resolved"] },
    "severity": { "type": "string", "enum": ["warning", "critical"] },
    "reason_code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "x-kasitek": {
    "identity": "connection.incident.lifecycle@1",
    "owner": "core-connections",
    "privacy_class": "aggregate",
    "prohibited_fields": [
      "display_name",
      "handle",
      "external_account_id",
      "metadata",
      "last_error",
      "error_message",
      "credential",
      "token",
      "provider_payload"
    ]
  }
}
