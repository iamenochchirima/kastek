{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasitek.co.za/analytics/metrics/registry.schema.json",
  "title": "KasiTek analytics registry source",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "definitions"],
  "properties": {
    "kind": { "enum": ["metrics", "dimensions", "metric_sets"] },
    "definitions": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "metrics" } } },
      "then": { "properties": { "definitions": { "items": { "$ref": "#/$defs/metric" } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "dimensions" } } },
      "then": { "properties": { "definitions": { "items": { "$ref": "#/$defs/dimension" } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "metric_sets" } } },
      "then": { "properties": { "definitions": { "items": { "$ref": "#/$defs/metric_set" } } } }
    }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key", "version", "domain", "owner", "lifecycle", "description", "value_type",
        "unit", "sources", "formula", "time_semantics", "default_aggregation",
        "eligible_population", "exclusions", "temporal_aggregation", "comparison",
        "deduplication", "descendant_aggregation", "supported_intervals", "scope_kinds",
        "dimensions", "permissions", "privacy_class", "exactness", "freshness", "coverage",
        "availability", "effective_from", "dependencies"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["draft", "active", "deprecated", "retired"] },
        "description": { "type": "string", "minLength": 1 },
        "value_type": { "enum": ["integer", "decimal", "duration", "currency", "ratio", "percentage"] },
        "unit": { "type": "string", "minLength": 1 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 8 },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "formula": { "type": "string", "minLength": 1 },
        "eligible_population": { "type": "string", "minLength": 1 },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "numerator": { "type": "string", "minLength": 1 },
        "denominator": { "type": "string", "minLength": 1 },
        "time_semantics": { "enum": ["event_time", "reporting_window", "snapshot", "current_state"] },
        "default_aggregation": { "enum": ["sum", "count", "distinct_count", "ratio_of_sums", "weighted_average", "latest", "percentile"] },
        "temporal_aggregation": { "enum": ["sum", "ratio_of_sums", "latest", "weighted_average", "distinct_count"] },
        "comparison": { "enum": ["none", "previous_period", "same_period_last_year"] },
        "deduplication": { "enum": ["none", "source_entity", "conversation", "recipient"] },
        "descendant_aggregation": { "enum": ["sum", "ratio_of_sums", "deduplicated", "latest", "weighted_average"] },
        "supported_intervals": { "type": "array", "minItems": 1, "items": { "enum": ["hour", "day", "week", "month"] } },
        "scope_kinds": { "type": "array", "minItems": 1, "items": { "enum": ["core_organization", "tenant_workspace", "tenant_client", "agents_organization"] } },
        "dimensions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "privacy_class": { "enum": ["aggregate", "restricted", "sensitive"] },
        "exactness": { "enum": ["exact", "estimated"] },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_age_seconds", "late_data_window_seconds"],
          "properties": {
            "max_age_seconds": { "type": "integer", "minimum": 0 },
            "late_data_window_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "required_sources"],
          "properties": {
            "mode": { "enum": ["complete", "partial", "estimated"] },
            "required_sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "availability": { "enum": ["always", "when_instrumented", "when_applicable"] },
        "effective_from": { "type": "string", "format": "date-time" },
        "replacement": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$" },
        "applicability": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$" } }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "source", "compatible_metrics", "filterable", "groupable", "cardinality", "privacy_class", "stable_key", "permissions"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
        "type": { "enum": ["string", "enum", "reference"] },
        "source": { "type": "string", "minLength": 1 },
        "compatible_metrics": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$" } },
        "filterable": { "type": "boolean" },
        "groupable": { "type": "boolean" },
        "cardinality": { "enum": ["low", "medium", "high", "bounded_high"] },
        "privacy_class": { "enum": ["aggregate", "restricted", "sensitive"] },
        "stable_key": { "type": "boolean" },
        "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "metric_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version", "owner", "lifecycle", "description", "metrics", "default_interval", "scope_kinds", "permissions"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
        "version": { "type": "integer", "minimum": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["draft", "active", "deprecated", "retired"] },
        "description": { "type": "string", "minLength": 1 },
        "metrics": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+$" } },
        "default_interval": { "enum": ["hour", "day", "week", "month"] },
        "scope_kinds": { "type": "array", "minItems": 1, "items": { "enum": ["core_organization", "tenant_workspace", "tenant_client", "agents_organization"] } },
        "permissions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
