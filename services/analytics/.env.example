ANALYTICS_ENVIRONMENT=development
ANALYTICS_API_HOST=0.0.0.0
ANALYTICS_API_PORT=4300
ANALYTICS_DATABASE_URL=postgres://analytics:analytics_dev_password@127.0.0.1:5432/kasitek_analytics
ANALYTICS_REDIS_URL=redis://127.0.0.1:6379
# Metrics are internal-only and require this bearer token when scraped.
ANALYTICS_METRICS_TOKEN=
# Only these authenticated producer identities may mutate or evaluate rollout controls.
# Empty means the internal rollout endpoints deny every caller.
ANALYTICS_ROLLOUT_ADMIN_PRODUCERS=
# PEM public key for signed customer-reporting grants. Leave empty until the issuing gateway is configured.
ANALYTICS_REPORTING_PUBLIC_KEY=
ANALYTICS_REPORTING_PUBLIC_KEYS_JSON=
# The matching private key stays only in Core/Tenant service environments; it is never configured here.
# Product services use the same key ID and one keyed public entry above.
ANALYTICS_REPORTING_KEY_ID=local-reporting-2026
ANALYTICS_REPORTING_ISSUERS=kasitek-core,kasitek-agent-platform,kasitek-tenant-platform
ANALYTICS_REPORTING_AUDIENCE=kasitek-analytics-reporting
# Source-bound tokens used only to resolve external Core/Tenant scope IDs into Analytics IDs.
# ANALYTICS_REPORTING_RESOLVER_CREDENTIALS_JSON='[{"source_service":"core","token":"replace-core-resolver-token"},{"source_service":"tenant-platform","token":"replace-tenant-resolver-token"}]'
# Private producer credentials. Replace these example tokens before enabling ingestion locally.
ANALYTICS_INGESTION_CREDENTIALS_JSON='[{"source_service":"core","producer_id":"core-customer-analytics","token":"replace-core-token"},{"source_service":"agent-platform","producer_id":"agent-platform-customer-analytics","token":"replace-agent-token"},{"source_service":"tenant-platform","producer_id":"tenant-platform-customer-analytics","token":"replace-tenant-token"}]'
ANALYTICS_DATABASE_MAX_CONNECTIONS=10
ANALYTICS_DATABASE_ACQUIRE_TIMEOUT_MS=5000
ANALYTICS_DATABASE_CONNECT_TIMEOUT_MS=5000
ANALYTICS_LOG_FILTER=info
# Set these only when the local PostgreSQL client is older than the server.
# ANALYTICS_PG_DUMP_BIN=/usr/lib/postgresql/18/bin/pg_dump
# ANALYTICS_PG_RESTORE_BIN=/usr/lib/postgresql/18/bin/pg_restore
