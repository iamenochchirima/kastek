{
  "name": "@kasitek/analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/api-main.js",
    "start:worker": "node dist/worker-main.js",
    "migrate": "node dist/migrate-main.js",
    "registry:check": "node dist/registry-main.js --check",
    "registry:write": "node dist/registry-main.js --write"
  },
  "dependencies": {
    "@kasitek-labs/contracts": "workspace:*",
    "@kasitek-labs/server-support": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "dotenv": "^16.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "fastify": "^5.6.1",
    "redis": "^5.11.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
