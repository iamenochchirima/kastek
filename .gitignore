# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/test-results/
**/.playwright/

# next.js
.next/
out/

# production
/build

# Docusaurus generated output; build these directories in CI or during local preview.
docs/**/.docusaurus/
docs/**/build/

# misc
.DS_Store
*.pem
/target
**/target

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.vault
!**/.env.vault
!**/.env.example
!server/kasitek-core/.env.identity.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

**/generated/prisma
**/dist/
**/.backups/
**/.artifacts/

# local-only working files (prompts, experiments, drafts)
local-work/
outreach-emails/
/.local/
/.audit/

.flaskenv*
!.env.project

# Monorepo runtime and private migration artifacts
**/.runtime/
**/coverage/
**/build/
**/.audit/
!**/.env.identity.example

**/.docusaurus/

# React Router generated route types
**/.react-router/

# Python bytecode caches
__pycache__/
*.pyc
*.pyo

# Bundled inline MCP App UI
