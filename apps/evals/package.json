{
  "name": "@kasitek/evals",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --import tsx src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "pnpm typecheck && vite build",
    "start": "node --import tsx src/server/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "lucide-react": "0.577.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
